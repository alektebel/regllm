			t1.PV_COST_L2_MAN_SCIC, 
			t1.PV_COST_L2_VTA_SCIC, 
			t1.PV_GA_TOT_SCIC, 
			t1.PV_QUITA_SCIC, 
			t1.PV_QUITA_CORR_SCIC, 
			t1.PV_AD_CORR_SCIC, 
			t1.OR_EAD_ENC, 
			t1.ID_CASO_ENC, 
			t1.LGD_OBSERVADA_ENC,
			T1.OR_EAD_NOMINAL_ENC,
			t1.ID_CASO_NOMINAL_ENC,
			T1.LGD_NOMINAL_ENC


		FROM &LIBWORK.&PREF_PROG._02_AUX_03 T1;
	QUIT;
		
	*HACER CHECK SI LA LGD ENC = LGD DEL CICLO PARA LA ÚLTIMA OBSERVACIÓN;
	DATA &LIBWORK.CH_LGD_ENC_&SUF_TAB_ENC.;
		SET &LIBWORK.BASE_LGD_ENC;

		IF FC_FECFINCIC_LGD = FEC_OBS;
		IF ROUND(LGD_OBSERVADA_CORR,0.01) NE ROUND(LGD_OBSERVADA_ENC,0.01);

	RUN;

	*CRUZAR LAS LGD ENCs CON LA TABLA DE LA LGD PRE FILT;
	PROC SQL;
		CREATE TABLE &LIBWORK.&PREF_PROG._02 AS SELECT DISTINCT
			T1.*
			, t2.ID_CASO_ENC
			, t2.OR_EAD_ENC 
			, t2.LGD_OBSERVADA_ENC
			, t2.ID_CASO_NOMINAL_ENC
			, T2.OR_EAD_NOMINAL_ENC
			, T2.LGD_NOMINAL_ENC

		FROM &LIBWORK.&PREF_PROG._01 AS T1

		LEFT JOIN &LIBWORK.BASE_LGD_ENC AS T2
		ON T1.ID_CONTR_CICLO_LGD = T2.ID_CONTR_CICLO_LGD
			AND T1.PERIODO = T2.PERIODO

		ORDER BY T1.ID_CONTR_CICLO_LGD, T1.PERIODO;
	QUIT;

%MEND;

