*macro invocada en mitad de la macro LGD_CICLO_ENC;
%MACRO LGD_ENC(PREF_PROG, SUF_TAB_ENC) ;
	
	*EXTRAER LA TABLA DE LA LGD_PRE, ORDENAR POR CICLO Y FEC_OBS;
	*RECUPERO ALGUNOS CAMPOS DEL FLUJO I;
	PROC SQL;
		CREATE TABLE &LIBWORK.&PREF_PROG._01 AS SELECT DISTINCT
			T1.*, 
			t2.PV_AD_VAL, 
			t2.PV_COST_L2_ADJ, 
			t2.PV_COST_L2_MAN, 
			t2.PV_COST_L2_VTA, 
			t2.PV_GA_TOT_VAL, 
			t2.PV_GR_L1_VAL, 
			t2.PV_PC_CORR, 
			t2.PV_PC_VAL, 
			t2.PV_PRECIO_VTA, 
			t2.PV_QUITA_CORR, 
			t2.PV_QUITA_VAL,
			T2.PV_QUITA_PREV
			, t2.OR_EAD_TEMP_NOMINAL

		FROM &LIBWORK.&PREF_PROG._01_AUX AS T1

		left join &T_IN_LPF_CIC_LGD_ENC. as t2
		on t1.ID_CONTR_CICLO_LGD = t2.ID_CONTR_CICLO_LGD
		and t1.FEC_OBS = t2.FEC_OBS

		ORDER BY T1.ID_CONTR_CICLO_LGD, T1.FEC_OBS;
	QUIT;


	*CREAR LA EAD BEST ESTIMATE Y DROPEAR TODAS LAS VARIABLES QUE SE CREARÁN EN ESTE PROCESO MES A MES;
	DATA &LIBWORK.&PREF_PROG._02_AUX_01  /*(DROP = OR_PC_SCIC OR_PC_CORR_SCIC OR_PRECIO_VTA_SCIC OR_AD_SCIC OR_GR_L1_SCIC */
/*					      OR_COST_L2_ADJ_SCIC OR_COST_L2_MAN_SCIC OR_COST_L2_VTA_SCIC OR_GA_TOT_SCIC */
/*						  OR_QUITA_SCIC OR_QUITA_CORR_SCIC*/
/*						  PV_PC_SCIC PV_PC_CORR_SCIC PV_PRECIO_VTA_SCIC */
/*			   			  PV_AD_SCIC PV_GR_L1_SCIC PV_COST_L2_ADJ_SCIC PV_COST_L2_MAN_SCIC PV_COST_L2_VTA_SCIC */
/*			   			  PV_GA_TOT_SCIC PV_QUITA_SCIC PV_QUITA_CORR_SCIC PV_AD_CORR_SCIC */
/*						)*/
;
		SET &LIBWORK.&PREF_PROG._01;
		where FEC_OBS BETWEEN FC_FECINICIC_LGD AND FC_FECFINCIC_LGD;
/*		OR_EAD_TEMP_ENC = OR_EAD_TEMP;*/
		OR_EAD_TEMP_ENC = OR_EAD_TEMP_NOMINAL;
		
	RUN;


	*CALCULAR LOS FLUJOS ACUMULADOS EN CADA MOMENTO;
	DATA &LIBWORK.&PREF_PROG._02_AUX_02;
		SET &LIBWORK.&PREF_PROG._02_AUX_01;

		BY ID_CONTR_CICLO_LGD;

		RETAIN OR_PC_SCIC OR_PC_CORR_SCIC 
				OR_PRECIO_VTA_SCIC 
				OR_AD_SCIC OR_GR_L1_SCIC 
				OR_COST_L2_ADJ_SCIC OR_COST_L2_MAN_SCIC 
				OR_COST_L2_VTA_SCIC 
				OR_GA_TOT_SCIC OR_QUITA_SCIC OR_QUITA_CORR_SCIC
				PV_PC_SCIC PV_PC_CORR_SCIC PV_PRECIO_VTA_SCIC 
			   PV_AD_SCIC PV_GR_L1_SCIC PV_COST_L2_ADJ_SCIC PV_COST_L2_MAN_SCIC PV_COST_L2_VTA_SCIC 
			   PV_GA_TOT_SCIC PV_QUITA_SCIC PV_QUITA_CORR_SCIC PV_AD_CORR_SCIC
				OR_QUITA_PREV_SCIC PV_QUITA_PREV_SCIC;


		IF FIRST.ID_CONTR_CICLO_LGD THEN DO;
			OR_PC_SCIC 				= OR_PC2;
			OR_PC_CORR_SCIC 		= OR_PC3_CORR;
			OR_PRECIO_VTA_SCIC 		= PRECIO_VTA;
			OR_AD_SCIC 				= OR_AD2;
			OR_GR_L1_SCIC 			= IM_GR_L1;
			OR_COST_L2_ADJ_SCIC 	= COST_L2_ADJ;
			OR_COST_L2_MAN_SCIC 	= COST_L2_MAN;
			OR_COST_L2_VTA_SCIC 	= COST_L2_VTA;
			OR_GA_TOT_SCIC 			= IM_GA_TOT;
			OR_QUITA_PREV_SCIC 		= IM_QUITA_PREVIA;
			OR_QUITA_SCIC 			= IM_IMPORTE_QUITA;
			OR_QUITA_CORR_SCIC 		= OR_QUITA3_CORR;
			PV_PC_SCIC 				= PV_PC_VAL;
			PV_PC_CORR_SCIC 		= PV_PC_CORR;
			PV_PRECIO_VTA_SCIC 		= PV_PRECIO_VTA;
			PV_AD_SCIC 				= PV_AD_VAL;
			PV_GR_L1_SCIC 			= PV_GR_L1_VAL;
			PV_COST_L2_ADJ_SCIC 	= PV_COST_L2_ADJ; 
			PV_COST_L2_MAN_SCIC 	= PV_COST_L2_MAN; 
			PV_COST_L2_VTA_SCIC 	= PV_COST_L2_VTA;
			PV_GA_TOT_SCIC 			= PV_GA_TOT_VAL; 
			PV_QUITA_PREV_SCIC 		= PV_QUITA_PREV;
			PV_QUITA_SCIC 			= PV_QUITA_VAL; 
			PV_QUITA_CORR_SCIC 		= PV_QUITA_CORR; 

			IF SEGM_CAT_NDOD_PRI IN ('EMPR') THEN DO;
					OR_AD_CORR_SCIC = 0;
					PV_AD_CORR_SCIC = 0;
			END;
			ELSE DO;
					OR_AD_CORR_SCIC = OR_AD_SCIC;
					PV_AD_CORR_SCIC = PV_AD_SCIC;
			END;

			IF SEGM_CAT_NDOD_PRI IN ('EMPR') THEN DO;
					OR_EAD_NOMINAL_ENC_SOLO_AD 	= OR_EAD_TEMP_ENC - OR_AD_SCIC;
					OR_EAD_ENC_SOLO_AD 			= OR_EAD_TEMP_ENC - PV_AD_SCIC;
			END;
			ELSE DO;
					OR_EAD_NOMINAL_ENC_SOLO_AD	= OR_EAD_TEMP_ENC;
					OR_EAD_ENC_SOLO_AD 			= OR_EAD_TEMP_ENC;
			END;
		END;
		ELSE DO;
			OR_PC_SCIC 				= 			OR_PC_SCIC + OR_PC2;
			OR_PC_CORR_SCIC 		= 	   OR_PC_CORR_SCIC + OR_PC3_CORR;
			OR_PRECIO_VTA_SCIC 		=   OR_PRECIO_VTA_SCIC + PRECIO_VTA;
			OR_AD_SCIC 				= 			OR_AD_SCIC + OR_AD2;
			OR_GR_L1_SCIC 			= 		 OR_GR_L1_SCIC + IM_GR_L1;
			OR_COST_L2_ADJ_SCIC 	=  OR_COST_L2_ADJ_SCIC + COST_L2_ADJ;
			OR_COST_L2_MAN_SCIC 	=  OR_COST_L2_MAN_SCIC + COST_L2_MAN;
			OR_COST_L2_VTA_SCIC 	=  OR_COST_L2_VTA_SCIC + COST_L2_VTA;
			OR_GA_TOT_SCIC 			= 		OR_GA_TOT_SCIC + IM_GA_TOT;
			OR_QUITA_PREV_SCIC 		= 	OR_QUITA_PREV_SCIC + IM_QUITA_PREVIA;
			OR_QUITA_SCIC 			= 		 OR_QUITA_SCIC + IM_IMPORTE_QUITA;
			OR_QUITA_CORR_SCIC 		= 	OR_QUITA_CORR_SCIC + OR_QUITA3_CORR;
			PV_PC_SCIC 				= 			PV_PC_SCIC + PV_PC_VAL;
			PV_PC_CORR_SCIC 		= 	   PV_PC_CORR_SCIC + PV_PC_CORR;
			PV_PRECIO_VTA_SCIC 		= 	PV_PRECIO_VTA_SCIC + PV_PRECIO_VTA;
			PV_AD_SCIC 				= 			PV_AD_SCIC + PV_AD_VAL;
			PV_GR_L1_SCIC 			= 		 PV_GR_L1_SCIC + PV_GR_L1_VAL;
			PV_COST_L2_ADJ_SCIC 	=  PV_COST_L2_ADJ_SCIC + PV_COST_L2_ADJ; 
			PV_COST_L2_MAN_SCIC 	=  PV_COST_L2_MAN_SCIC + PV_COST_L2_MAN; 
			PV_COST_L2_VTA_SCIC 	=  PV_COST_L2_VTA_SCIC + PV_COST_L2_VTA; 
			PV_GA_TOT_SCIC 			= 		PV_GA_TOT_SCIC + PV_GA_TOT_VAL; 
			PV_QUITA_PREV_SCIC 		= 	PV_QUITA_PREV_SCIC + PV_QUITA_PREV; 
			PV_QUITA_SCIC 			= 		 PV_QUITA_SCIC + PV_QUITA_VAL; 
			PV_QUITA_CORR_SCIC 		= 	PV_QUITA_CORR_SCIC + PV_QUITA_CORR; 

			IF SEGM_CAT_NDOD_PRI IN ('EMPR') THEN DO;
					OR_AD_CORR_SCIC = 0;
					PV_AD_CORR_SCIC = 0;
			END;
			ELSE DO;
					OR_AD_CORR_SCIC = OR_AD_SCIC;
					PV_AD_CORR_SCIC = PV_AD_SCIC;
			END;

			IF SEGM_CAT_NDOD_PRI IN ('EMPR') THEN DO;
					OR_EAD_NOMINAL_ENC_SOLO_AD 	= OR_EAD_TEMP_ENC - OR_AD_SCIC;
					OR_EAD_ENC_SOLO_AD 		= OR_EAD_TEMP_ENC - PV_AD_SCIC;
			END;
			ELSE DO;
					OR_EAD_NOMINAL_ENC_SOLO_AD	= OR_EAD_TEMP_ENC;
					OR_EAD_ENC_SOLO_AD 			= OR_EAD_TEMP_ENC;
			END;
		END;
		
		OR_EAD_NOMINAL_ENC = OR_EAD_NOMINAL_ENC_SOLO_AD + OR_QUITA_PREV_SCIC;
		OR_EAD_ENC = OR_eAD_ENC_SOLO_AD + PV_QUITA_PREV_SCIC;
		
	RUN;


	*APLICAR LAS FORMULAS DE LA LGD;
	PROC SQL;
		CREATE TABLE &LIBWORK.&PREF_PROG._02_AUX_03 AS SELECT DISTINCT	
			*
			, (CASE 
				WHEN OR_EAD_ENC < 0.005 THEN 0
				WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 1 
				WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND PV_GA_TOT_SCIC LE PV_GR_L1_SCIC THEN 2
				WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 3 
				WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND PV_GA_TOT_SCIC LE PV_GR_L1_SCIC THEN 4
				WHEN 													PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 5
				ELSE 6 
			END) AS ID_CASO_ENC
			, (CASE 
				WHEN OR_EAD_NOMINAL_ENC < 0.005 THEN 0
                WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 1 
                WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND OR_GA_TOT_SCIC LE OR_GR_L1_SCIC THEN 2
                WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 3 
                WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND OR_GA_TOT_SCIC LE OR_GR_L1_SCIC THEN 4
                WHEN 													OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 5
                ELSE 6  
			END) AS ID_CASO_NOMINAL_ENC	 

			, (case 
				WHEN CALCULATED ID_CASO_NOMINAL_ENC = 0 THEN 0

				when CALCULATED ID_CASO_NOMINAL_ENC = 1 then 
					(OR_EAD_NOMINAL_ENC 					+ OR_COST_L2_ADJ_SCIC + OR_COST_L2_MAN_SCIC + OR_COST_L2_VTA_SCIC 
					- (OR_PC_CORR_SCIC 						+ OR_AD_CORR_SCIC + OR_PRECIO_VTA_SCIC)) / OR_EAD_NOMINAL_ENC 

				when CALCULATED ID_CASO_NOMINAL_ENC = 2 then
					(OR_EAD_NOMINAL_ENC + OR_GR_L1_SCIC 	+ OR_COST_L2_ADJ_SCIC + OR_COST_L2_MAN_SCIC + OR_COST_L2_VTA_SCIC 
					- (OR_PC_CORR_SCIC 	+ OR_GA_TOT_SCIC 	+ OR_AD_CORR_SCIC + OR_PRECIO_VTA_SCIC)) / OR_EAD_NOMINAL_ENC 

				when CALCULATED ID_CASO_NOMINAL_ENC = 3 then
					(OR_EAD_NOMINAL_ENC 					+ OR_QUITA_CORR_SCIC 
					- (OR_PC_CORR_SCIC 						+ OR_AD_CORR_SCIC)) / OR_EAD_NOMINAL_ENC 

				when CALCULATED ID_CASO_NOMINAL_ENC = 4 then
					(OR_EAD_NOMINAL_ENC + OR_GR_L1_SCIC 	+ OR_QUITA_CORR_SCIC 
					- (OR_PC_CORR_SCIC 	+ OR_GA_TOT_SCIC 	+ OR_AD_CORR_SCIC)) / OR_EAD_NOMINAL_ENC 

				when CALCULATED ID_CASO_NOMINAL_ENC = 5 then
					(OR_EAD_NOMINAL_ENC 					+ OR_QUITA_SCIC 
					- (OR_PC_SCIC 							+ OR_AD_CORR_SCIC)) / OR_EAD_NOMINAL_ENC

				else 
					(OR_EAD_NOMINAL_ENC + OR_GR_L1_SCIC 	+ OR_QUITA_SCIC 
					- (OR_PC_SCIC 		+ OR_GA_TOT_SCIC 	+ OR_AD_CORR_SCIC)) / OR_EAD_NOMINAL_ENC 
			end) as LGD_NOMINAL_ENC

			, (case WHEN CALCULATED ID_CASO_ENC = 0 THEN 0

				when CALCULATED ID_CASO_ENC = 1 then 
					(OR_EAD_ENC 							+ PV_COST_L2_ADJ_SCIC + PV_COST_L2_MAN_SCIC + PV_COST_L2_VTA_SCIC
					- (PV_PC_CORR_SCIC 						+ PV_AD_CORR_SCIC + PV_PRECIO_VTA_SCIC)) / OR_EAD_ENC 

				when CALCULATED ID_CASO_ENC = 2 then
					(OR_EAD_ENC 		+ PV_GR_L1_SCIC 	+ PV_COST_L2_ADJ_SCIC + PV_COST_L2_MAN_SCIC + PV_COST_L2_VTA_SCIC 
					- (PV_PC_CORR_SCIC 	+ PV_AD_CORR_SCIC 	+ PV_GA_TOT_SCIC + PV_PRECIO_VTA_SCIC)) / OR_EAD_ENC 

				when CALCULATED ID_CASO_ENC = 3 then
					(OR_EAD_ENC 							+ PV_QUITA_CORR_SCIC 
					- (PV_PC_CORR_SCIC 						+ PV_AD_CORR_SCIC)) / OR_EAD_ENC 

				when CALCULATED ID_CASO_ENC = 4 then
					(OR_EAD_ENC 		+ PV_GR_L1_SCIC 	+ PV_QUITA_CORR_SCIC 
					- (PV_PC_CORR_SCIC 	+ PV_GA_TOT_SCIC	+ PV_AD_CORR_SCIC )) / OR_EAD_ENC 

				when CALCULATED ID_CASO_ENC = 5 then
					(OR_EAD_ENC 							+ PV_QUITA_SCIC 
					- (PV_PC_SCIC 							+ PV_AD_CORR_SCIC)) / OR_EAD_ENC

				else 
					(OR_EAD_ENC 		+ PV_GR_L1_SCIC 	+ PV_QUITA_SCIC 
					- (PV_PC_SCIC 		+ PV_GA_TOT_SCIC	+ PV_AD_CORR_SCIC)) / OR_EAD_ENC 
			end) as LGD_OBSERVADA_ENC	 


		FROM &LIBWORK.&PREF_PROG._02_AUX_02

		ORDER BY ID_CONTR_CICLO_LGD;
	QUIT;


	*HACER UN SELECT DE LOS CAMPOS NIVEL CICLO - FECHA DE REFERENCIA;
	PROC SQL;
		CREATE TABLE &LIBWORK.BASE_LGD_ENC  AS SELECT
			T1.ID_CONTR_CICLO_LGD,
			t1.PERIODO,
			T1.FEC_OBS,
			T1.FC_FECINICIC_LGD,
			T1.FC_FECFINCIC_LGD,
/*			t1.SEGMBSINI_PRI, */
			t1.SEGM_CAT_NDOD_PRI, 
/*			T1.MARCA_PROMO_CAP_PRI,*/
/*			T1.MARCA_PROMO_AS_PRI,*/
/*			t1.SEGRIE_CAT_NDOD_PRI, */
/*			t1.SW_HIPO_BD_PRI,*/
/*			t1.SW_HIPO_AS_PRI, */
			t1.SW_MARCA_HIPO_PRI, 
/*			t1.MOTIVO_ENTRADA_NDOD_PRI, */
/*			t1.MOTIVO_MAS_GRAVE_NDOD_PRI,*/

			T1.ID_CASO_CORR,
			T1.LGD_OBSERVADA_CORR,
			t1.TIPO_LGD, 
			t1.OR_EAD_TEMP,
			T1.OR_EAD_TEMP_ENC,
			t1.PV_PC_SCIC, 
			t1.PV_PC_CORR_SCIC, 
			t1.PV_PRECIO_VTA_SCIC, 
			t1.PV_AD_SCIC, 
			t1.PV_GR_L1_SCIC, 
