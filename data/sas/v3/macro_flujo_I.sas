PROC SQL;
     CREATE TABLE &LIBWORK.&PREFIJO_PROGRAMA._01 AS SELECT
/*        *,*/
          ID_CONTR_CICLO_LGD
          , FEC_OBS

          , FC_FECINICIC_LGD
          , FC_FECFINCIC_LGD
 
          , TIPO_LGD
		  , DIST_ANY_OBS1
		  , DIST_ANY_OBS2

		  , OR_EAD_NOMINAL
		  , OR_EAD
		  , OR_EAD_BE
		  , OR_EAD_NOMINAL_BE
		  , OR_EAD_ENC
		  , OR_EAD_NOMINAL_ENC

		  , OR_DISPTO
		  , DRIVER_CI_MENSUAL
          , OR_DISPTO * DRIVER_CI_MENSUAL AS OR_COSTE_INDIRECTO

		  , 	LGD_NOMINAL_CORR
		  , ID_CASO_NOMINAL_CORR
		  ,   LGD_OBSERVADA_CORR
		  , 		ID_CASO_CORR
		  , LGD_OBSERVADA_CENS
		  , 	LGD_NOMINAL_BE
		  , ID_CASO_NOMINAL_BE
		  ,   LGD_OBSERVADA_BE
		  , 		ID_CASO_BE
		  , 	LGD_NOMINAL_ENC
		  , ID_CASO_NOMINAL_ENC
		  ,   LGD_OBSERVADA_ENC
		  , 		ID_CASO_ENC

 
	 FROM &LIBWORK.&PREFIJO_PROGRAMA._01_AUX_02
     ORDER BY ID_CONTR_CICLO_LGD, FEC_OBS
;QUIT;
 
DATA &LIBWORK.&PREFIJO_PROGRAMA._02;
SET &LIBWORK.&PREFIJO_PROGRAMA._01;
 PV_COSTE_INDIRECTO_VAL = OR_COSTE_INDIRECTO / (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
RUN;

PROC SQL;
CREATE TABLE &LIBWORK.&PREFIJO_PROGRAMA._03 AS
SELECT 
	*
	, SUM(OR_COSTE_INDIRECTO	) AS OR_COSTE_INDIRECTO_SCIC
	, SUM(PV_COSTE_INDIRECTO_VAL) AS PV_COSTE_INDIRECTO_SCIC
FROM &LIBWORK.&PREFIJO_PROGRAMA._02
GROUP BY ID_CONTR_CICLO_LGD
ORDER BY ID_CONTR_CICLO_LGD, FEC_OBS

;QUIT;

DATA &LIBWORK.&PREFIJO_PROGRAMA._04;
SET &LIBWORK.&PREFIJO_PROGRAMA._03;
	BY ID_CONTR_CICLO_LGD;
	RETAIN PV_COSTE_INDIRECTO_SCIC_ENC PV_COSTE_INDIRECTO_SCIC_BE OR_COSTE_INDIRECTO_SCIC_ENC OR_COSTE_INDIRECTO_SCIC_BE 
		   OR_COSTE_INDIRECTO_KEEP PV_COSTE_INDIRECTO_VAL_KEEP;
	IF FIRST.ID_CONTR_CICLO_LGD THEN DO;
		PV_COSTE_INDIRECTO_SCIC_ENC = PV_COSTE_INDIRECTO_VAL;
		PV_COSTE_INDIRECTO_SCIC_BE  = PV_COSTE_INDIRECTO_SCIC;
		OR_COSTE_INDIRECTO_SCIC_ENC = OR_COSTE_INDIRECTO;
		OR_COSTE_INDIRECTO_SCIC_BE  = OR_COSTE_INDIRECTO_SCIC;
	END;
	ELSE DO;
		PV_COSTE_INDIRECTO_SCIC_ENC = PV_COSTE_INDIRECTO_SCIC_ENC + PV_COSTE_INDIRECTO_VAL_KEEP;
		PV_COSTE_INDIRECTO_SCIC_BE  = PV_COSTE_INDIRECTO_SCIC_BE  - PV_COSTE_INDIRECTO_VAL_KEEP;
		OR_COSTE_INDIRECTO_SCIC_ENC = OR_COSTE_INDIRECTO_SCIC_ENC + OR_COSTE_INDIRECTO_KEEP;
		OR_COSTE_INDIRECTO_SCIC_BE  = OR_COSTE_INDIRECTO_SCIC_BE  - OR_COSTE_INDIRECTO_KEEP;
	END;

	OR_COSTE_INDIRECTO_KEEP = OR_COSTE_INDIRECTO;
	PV_COSTE_INDIRECTO_VAL_KEEP = PV_COSTE_INDIRECTO_VAL;

IF 		ID_CASO_NOMINAL_CORR 	= 0 then do; LGD_NOMINAL_CORR_CI	= 0; end; else do; LGD_NOMINAL_CORR_CI 		= (LGD_NOMINAL_CORR 	+ (OR_COSTE_INDIRECTO_SCIC		/OR_EAD_NOMINAL		)); end;
IF 		ID_CASO_CORR 			= 0 then do; LGD_OBSERVADA_CORR_CI 	= 0; end; else do; LGD_OBSERVADA_CORR_CI 	= (LGD_OBSERVADA_CORR 	+ (PV_COSTE_INDIRECTO_SCIC		/OR_EAD				)); end;
IF 		ID_CASO_NOMINAL_BE 		= 0 then do; LGD_NOMINAL_BE_CI 		= 0; end; else do; LGD_NOMINAL_BE_CI 		= (LGD_NOMINAL_BE 		+ (OR_COSTE_INDIRECTO_SCIC_BE	/OR_EAD_NOMINAL_BE	)); end;
IF 		ID_CASO_BE 				= 0 then do; LGD_OBSERVADA_BE_CI 	= 0; end; else do; LGD_OBSERVADA_BE_CI 		= (LGD_OBSERVADA_BE 	+ (PV_COSTE_INDIRECTO_SCIC_BE	/OR_EAD_BE			)); end;
IF 		ID_CASO_NOMINAL_ENC 	= 0 then do; LGD_NOMINAL_ENC_CI 	= 0; end; else do; LGD_NOMINAL_ENC_CI 		= (LGD_NOMINAL_ENC 		+ (OR_COSTE_INDIRECTO_SCIC_ENC	/OR_EAD_NOMINAL_ENC	)); end;
IF 		ID_CASO_ENC 			= 0 then do; LGD_OBSERVADA_ENC_CI 	= 0; end; else do; LGD_OBSERVADA_ENC_CI 	= (LGD_OBSERVADA_ENC 	+ (PV_COSTE_INDIRECTO_SCIC_ENC	/OR_EAD_ENC			)); end;

;RUN;

