PROC SQL;
	CREATE TABLE &LIBWORK.&PREFIJO_PROGRAMA._05 AS SELECT
	DISTINCT

/*		*,*/
		ID_CONTR_CICLO_LGD
		, T1.FC_FECINICIC_LGD
		, T1.FC_FECFINCIC_LGD
		, T1.SEGM_CAT_NDOD_PRI
		, T1.SW_ALTA_INMUEBLE_CTO
		, T1.SW_MARCA_HIPO_PRI
		, T1.SW_NOT_ADJ
		, T1.OR_EAD_TEMP_NOMINAL
		, T1.OR_EAD_TEMP
		, T1.TERMINACION
/*		, MAX(CASE WHEN T1.OP_LGD_DEF IS NULL THEN 0 ELSE 1 END) AS SW_OP_LGD_DEF*/
		, SW_OP_LGD_DEF
/*		, SW_OP_LGD*/
		,
		
		SUM(OR_PC2) 			AS OR_PC_SCIC,
		SUM(OR_PC3_CORR) 		AS OR_PC_CORR_SCIC,
		SUM(PRECIO_VTA) 		AS OR_PRECIO_VTA_SCIC,

		SUM(OR_AD2) 			AS OR_AD_SCIC,
		SUM(IM_GR_L1) 			AS OR_GR_L1_SCIC,

		SUM(COST_L2_ADJ) 		AS OR_COST_L2_ADJ_SCIC,
		SUM(COST_L2_MAN) 		AS OR_COST_L2_MAN_SCIC,
		SUM(COST_L2_VTA) 		AS OR_COST_L2_VTA_SCIC,

		SUM(IM_GA_TOT) 			AS OR_GA_TOT_SCIC,
		SUM(IM_QUITA_PREVIA) 	AS OR_QUITA_PREV_SCIC,
		SUM(IM_IMPORTE_QUITA)	AS OR_QUITA_SCIC,
		SUM(OR_QUITA3_CORR)		AS OR_QUITA_CORR_SCIC,



		SUM(PV_PC_VAL) 			AS PV_PC_SCIC,
		SUM(PV_PC_CORR) 		AS PV_PC_CORR_SCIC,
		SUM(PV_PRECIO_VTA) 		AS PV_PRECIO_VTA_SCIC,

		SUM(PV_AD_VAL) 			AS PV_AD_SCIC,
		SUM(PV_GR_L1_VAL) 		AS PV_GR_L1_SCIC,

		SUM(PV_COST_L2_ADJ) 	AS PV_COST_L2_ADJ_SCIC,
		SUM(PV_COST_L2_MAN) 	AS PV_COST_L2_MAN_SCIC,
		SUM(PV_COST_L2_VTA) 	AS PV_COST_L2_VTA_SCIC,

		SUM(PV_GA_TOT_VAL) 		AS PV_GA_TOT_SCIC,
		SUM(PV_QUITA_PREV)		AS PV_QUITA_PREV_SCIC,
		SUM(PV_QUITA_VAL)		AS PV_QUITA_SCIC,
		SUM(PV_QUITA_CORR)		AS PV_QUITA_CORR_SCIC

	FROM &LIBWORK.&PREFIJO_PROGRAMA._04 AS T1
	GROUP BY ID_CONTR_CICLO_LGD;
QUIT;


PROC SQL;
	CREATE TABLE &LIBWORK.&PREFIJO_PROGRAMA._06 AS SELECT
		T1.*

		, (CASE WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN 0
				ELSE OR_AD_SCIC 
		END) AS OR_AD_CORR_SCIC
 
        , (CASE WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN (OR_EAD_TEMP_NOMINAL - OR_AD_SCIC)
				ELSE OR_EAD_TEMP_NOMINAL 
		END) AS OR_EAD_NOMINAL_SOLO_AD

		, (CALCULATED OR_EAD_NOMINAL_SOLO_AD) + OR_QUITA_PREV_SCIC
		AS OR_EAD_NOMINAL

		, (CASE WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN 0
			  	ELSE PV_AD_SCIC 
		END) AS PV_AD_CORR_SCIC

		, (CASE WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN (OR_EAD_TEMP_NOMINAL - PV_AD_SCIC)
				ELSE OR_EAD_TEMP_NOMINAL 
		END) AS OR_EAD_SOLO_AD

		, (CALCULATED OR_EAD_SOLO_AD) + PV_QUITA_PREV_SCIC
		AS OR_EAD


	FROM &LIBWORK.&PREFIJO_PROGRAMA._05 AS T1
	;
	QUIT;


PROC SQL;
	CREATE TABLE &LIBWORK.&PREFIJO_PROGRAMA._07 AS SELECT DISTINCT
		*,
		(CASE WHEN OR_EAD < 0.005 THEN 0
			  WHEN TERMINACION IN ("01. ADJ", "02. DACION") AND PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 1 /*ADJ-DAC: contr. hipo*/
			  WHEN TERMINACION IN ("01. ADJ", "02. DACION") AND PV_GA_TOT_SCIC LE PV_GR_L1_SCIC THEN 2 /*ADJ-DAC: contr. hipo*/
			  WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 AND PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 3  /*ADJ no HIPO*/
			  WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 AND PV_GA_TOT_SCIC LE PV_GR_L1_SCIC THEN 4 /*ADJ no HIPO*/
			  WHEN PV_GA_TOT_SCIC > PV_GR_L1_SCIC THEN 5 /*RESTA*/
			  ELSE 6 END /*RESTA*/
		) AS ID_CASO_CORR,

		(CASE WHEN OR_EAD_NOMINAL < 0.005 THEN 0
			  WHEN TERMINACION IN ("01. ADJ", "02. DACION") AND OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 1 /*ADJ-DAC: contr. hipo*/
			  WHEN TERMINACION IN ("01. ADJ", "02. DACION") AND OR_GA_TOT_SCIC LE OR_GR_L1_SCIC THEN 2 /*ADJ-DAC: contr. hipo*/
			  WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 AND OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 3  /*ADJ no HIPO*/
			  WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 AND OR_GA_TOT_SCIC LE OR_GR_L1_SCIC THEN 4 /*ADJ no HIPO*/
			  WHEN OR_GA_TOT_SCIC > OR_GR_L1_SCIC THEN 5 /*RESTA*/
			  ELSE 6 END /*RESTA*/
		) AS ID_CASO_NOMINAL_CORR, 


		
		(case WHEN CALCULATED ID_CASO_NOMINAL_CORR = 0 THEN 0
 
            when CALCULATED ID_CASO_NOMINAL_CORR = 1 then 
                    (OR_EAD_NOMINAL + OR_COST_L2_ADJ_SCIC + OR_COST_L2_MAN_SCIC + OR_COST_L2_VTA_SCIC - 
                                    (OR_PC_CORR_SCIC + OR_AD_CORR_SCIC + OR_PRECIO_VTA_SCIC)) / OR_EAD_NOMINAL 


            when CALCULATED ID_CASO_NOMINAL_CORR = 2 then
            (OR_EAD_NOMINAL + OR_GR_L1_SCIC + OR_COST_L2_ADJ_SCIC + OR_COST_L2_MAN_SCIC + OR_COST_L2_VTA_SCIC - 
                                            (OR_PC_CORR_SCIC + OR_AD_CORR_SCIC + OR_GA_TOT_SCIC + OR_PRECIO_VTA_SCIC)) / OR_EAD_NOMINAL 


            when CALCULATED ID_CASO_NOMINAL_CORR = 3 then
            (OR_EAD_NOMINAL + OR_QUITA_CORR_SCIC - (OR_PC_CORR_SCIC + OR_AD_CORR_SCIC)) / OR_EAD_NOMINAL 


            when CALCULATED ID_CASO_NOMINAL_CORR = 4 then
            (OR_EAD_NOMINAL + OR_QUITA_CORR_SCIC + OR_GR_L1_SCIC - (OR_PC_CORR_SCIC + OR_AD_CORR_SCIC + OR_GA_TOT_SCIC)) / OR_EAD_NOMINAL 


            when CALCULATED ID_CASO_NOMINAL_CORR = 5 then
            (OR_EAD_NOMINAL + OR_QUITA_SCIC - (OR_PC_SCIC + OR_AD_CORR_SCIC)) / OR_EAD_NOMINAL


            else (OR_EAD_NOMINAL + OR_GR_L1_SCIC + OR_QUITA_SCIC - (OR_PC_SCIC + OR_AD_CORR_SCIC + OR_GA_TOT_SCIC)) / OR_EAD_NOMINAL end) 
			as LGD_NOMINAL_CORR, 

 
		
		(case WHEN CALCULATED ID_CASO_CORR = 0 THEN 0

			when CALCULATED ID_CASO_CORR = 1 then 
				 (OR_EAD + PV_COST_L2_ADJ_SCIC + PV_COST_L2_MAN_SCIC + PV_COST_L2_VTA_SCIC - 
						(PV_PC_CORR_SCIC + PV_AD_CORR_SCIC + PV_PRECIO_VTA_SCIC)) / OR_EAD 


			when CALCULATED ID_CASO_CORR = 2 then
			(OR_EAD + PV_GR_L1_SCIC + PV_COST_L2_ADJ_SCIC + PV_COST_L2_MAN_SCIC + PV_COST_L2_VTA_SCIC - 
							(PV_PC_CORR_SCIC + PV_AD_CORR_SCIC + PV_GA_TOT_SCIC + PV_PRECIO_VTA_SCIC)) / OR_EAD 


			when CALCULATED ID_CASO_CORR = 3 then
			(OR_EAD + PV_QUITA_CORR_SCIC - (PV_PC_CORR_SCIC + PV_AD_CORR_SCIC)) / OR_EAD 


			when CALCULATED ID_CASO_CORR = 4 then
			(OR_EAD + PV_QUITA_CORR_SCIC + PV_GR_L1_SCIC - (PV_PC_CORR_SCIC + PV_AD_CORR_SCIC + PV_GA_TOT_SCIC)) / OR_EAD 


			when CALCULATED ID_CASO_CORR = 5 then
			(OR_EAD + PV_QUITA_SCIC - (PV_PC_SCIC + PV_AD_CORR_SCIC)) / OR_EAD


			else (OR_EAD + PV_GR_L1_SCIC + PV_QUITA_SCIC - (PV_PC_SCIC + PV_AD_CORR_SCIC + PV_GA_TOT_SCIC)) / OR_EAD end) 
			as LGD_OBSERVADA_CORR


		, (CASE 
			WHEN (CALCULATED LGD_OBSERVADA_CORR) < 0 THEN 1 
			WHEN (CALCULATED LGD_OBSERVADA_CORR) > 1.5 THEN 1
			ELSE 0 
		END) AS SW_LGD_CENS
		, (CASE 
			WHEN (CALCULATED LGD_OBSERVADA_CORR) < 0 THEN 0
			WHEN (CALCULATED LGD_OBSERVADA_CORR) > 1.5 THEN 1.5
			ELSE (CALCULATED LGD_OBSERVADA_CORR)
		END) AS LGD_OBSERVADA_CENS


	FROM &LIBWORK.&PREFIJO_PROGRAMA._06 AS T1

	ORDER BY ID_CONTR_CICLO_LGD;
QUIT;

