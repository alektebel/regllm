/*adaptado de L11 - Ajuste CORA P06*/
/*Corrección para calcular la EAD_TIT en base el DISPTO_TIT, así como aplicar también a la retocesión*/
/*%LET TABLA_RD_A_NIVEL_FEC_OBS = &PREFIJO_OUTPUT._LGD_PRE_FILT_VFO_K;*/
%LET TABLA_RD_A_NIVEL_FEC_OBS = &LIBWORK.I_P03_FIN;
