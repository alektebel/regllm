			OR_PC2 		= 0;
			OR_PC3_CORR = 0;
			PV_PC 		= 0;
		END;
	END;
	ELSE IF TERMINACION IN ('03. VENTA') THEN DO;
		IF FEC_OBS = FC_FECFINCIC_LGD THEN DO;
			IF FC_FECFINCIC_LGD <= FC_FEC_VENTA AND IM_IMPORTE_QUITA > 0 THEN DO;
				IM_IMPORTE_QUITA 	= 0;
				OR_QUITA3_CORR 		= 0;
			END;
		END;
	END;

