PROC SQL;
	CREATE TABLE &LIBWORK.&PREFIJO_PROGRAMA._03 AS SELECT DISTINCT
	*

	, (CASE WHEN t1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN 0
		  ELSE T1.PV_AD_VAL END) AS PV_AD_CORR
	
	,(CASE 	WHEN T1.ID_CASO_CORR = 1 THEN (PV_PC_CORR 					+ PV_PRECIO_VTA)
		  	WHEN T1.ID_CASO_CORR = 2 THEN (PV_PC_CORR + PV_GA_TOT_VAL 	+ PV_PRECIO_VTA)
			WHEN T1.ID_CASO_CORR = 3 THEN (PV_PC_CORR)
			WHEN T1.ID_CASO_CORR = 4 THEN (PV_PC_CORR + PV_GA_TOT_VAL)
			WHEN T1.ID_CASO_CORR = 5 THEN (PV_PC_VAL)
			WHEN T1.ID_CASO_CORR = 6 THEN (PV_PC_VAL  + PV_GA_TOT_VAL)
			ELSE 0 END) AS PV_RECUP_POS

	,(CASE 	WHEN T1.ID_CASO_CORR = 1 THEN (PV_COST_L2_ADJ 				 	- CALCULATED PV_AD_CORR + PV_COST_L2_MAN + PV_COST_L2_VTA)
		  	WHEN T1.ID_CASO_CORR = 2 THEN (PV_COST_L2_ADJ 	+ PV_GR_L1_VAL 	- CALCULATED PV_AD_CORR + PV_COST_L2_MAN + PV_COST_L2_VTA)
		  	WHEN T1.ID_CASO_CORR = 3 THEN (PV_QUITA_CORR 					- CALCULATED PV_AD_CORR)
		  	WHEN T1.ID_CASO_CORR = 4 THEN (PV_QUITA_CORR 	+ PV_GR_L1_VAL 	- CALCULATED PV_AD_CORR)
		  	WHEN T1.ID_CASO_CORR = 5 THEN (PV_QUITA_VAL 					- CALCULATED PV_AD_CORR)
		  	WHEN T1.ID_CASO_CORR = 6 THEN (PV_QUITA_VAL 	+ PV_GR_L1_VAL 	- CALCULATED PV_AD_CORR)
		  ELSE 0 END) AS PV_RECUP_NEG
			

	FROM &LIBWORK.&PREFIJO_PROGRAMA._02 as t1 

	ORDER BY ID_CONTR_CICLO_LGD;
QUIT;



