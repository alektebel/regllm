*variable para marcar si hay una OP_LGD o no en una FEC_OBS dada;
IF (/*OP_LGD ne '' or*/ OP_LGD_DEF ne '') then DO;
	SW_OP_LGD_INFO = 1;
end;
else do;
	SW_OP_LGD_INFO = 0; 
end;
*signo para la reducción por adj/dac, teniendo en cuenta que haremos max(abs(PC, precio_vta)):
si (D_PC_DESC, SW_OP_LGD_INFO) = (0, 0), entonces  0 --> no hay reducción por adj
si (D_PC_DESC, SW_OP_LGD_INFO) = (1, 0), entonces  1 --> la reducción por adj la tomaremos desde el PC
si (D_PC_DESC, SW_OP_LGD_INFO) = (0, 1), entonces  1 --> la reducción por adj la tomaremos desde el precio de venta
si (D_PC_DESC, SW_OP_LGD_INFO) = (1, 1), entonces -1 --> la reducción por adj será el menor valor entre PC y precio venta
;
SIGN_REDU = 0;
if 		D_PC_DESC = 0 and  SW_OP_LGD_INFO = 0 then do; SIGN_REDU =  0; end;
else if D_PC_DESC = 1 and  SW_OP_LGD_INFO = 0 then do; SIGN_REDU =  1; end;
else if D_PC_DESC = 0 and  SW_OP_LGD_INFO = 1 then do; SIGN_REDU =  1; end;
else if D_PC_DESC = 1 and  SW_OP_LGD_INFO = 1 then do; SIGN_REDU = -1; end;
RUN;

