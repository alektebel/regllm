		, T1.ID_CONTR_CICLO_LGD
		, T1.FC_FECINICIC_LGD
		, T1.FC_FECFINCIC_LGD
/*		, T1.SW_CALC_LGD*/
/*		, T1.ID_CONTRATO*/
/*		, T1.ID_PRODUCTO*/
/*		, T1.ID_TITULARITAT*/
		, T1.SW_MARCA_HIPO_PRI
		, T1.SEGM_CAT_NDOD_PRI
/*		, T1.SEGMBSINI_PRI*/
/*		, T1.MARCA_PROMO_CAP_PRI*/
/*		, T1.MARCA_PROMO_AS_PRI*/
/*		, T1.SEGRIE_CAT_NDOD_PRI*/
/*		, T1.SW_HIPO_BD_PRI*/
/*		, T1.SW_HIPO_AS_PRI*/
/*		, T1.MOTIVO_ENTRADA_NDOD_PRI*/
/*		, T1.MOTIVO_MAS_GRAVE_NDOD_PRI*/
		, T1.TERMINACION
		, T1.SW_ALTA_INMUEBLE_CTO
		, T1.SW_NOT_ADJ
		, T1.SW_OP_LGD_DEF
		, T1.D_PC_DESC
		, T1.OR_DISPTO
/*		, T1.OR_DISBLE*/
/*		, T1.OR_AVALES*/
/*		, T1.OR_FUTURS*/
/*		, T1.OR_AJUVAL*/
/*		, T1.OR_FAIRVA*/
/*		, T1.OR_PROVAPL*/
/*		, T1.OR_INTERES_DEV*/
		, T1.OR_PC2
		, T1.OR_AD2
		, T1.IM_GR_L1
		, T1.IM_GA_TOT
		, T1.IM_QUITA_PREVIA
		, T1.IM_IMPORTE_QUITA
/*		, T1.AJUSTE_PC*/
/*		, T1.OR_PC2_CORR*/
/*		, T1.AJUSTE_QUITA*/
/*		, T1.OR_QUITA_CORR*/
		, T1.PRECIO_VTA
		, T1.COST_L2_ADJ
		, T1.COST_L2_MAN
		, T1.COST_L2_VTA
		, T1.OR_PC3_CORR
		, T1.OR_QUITA3_CORR
		, T1.TIPO_LGD
		, T1.OR_EAD_TEMP
		, T1.OR_EAD
		, T1.ID_CASO_CORR
		, T1.ID_CASO_NOMINAL_CORR
		, T1.LGD_OBSERVADA_CORR
		, T1.SW_OP_LGD_INFO
		, T1.SIGN_REDU

FROM &LIBWORK.&PREF_PROG._01 AS T1

ORDER BY T1.ID_CONTR_CICLO_LGD, T1.FEC_OBS;
QUIT;

PROC SQL;
CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_00C AS SELECT DISTINCT
	T1.ID_CONTR_CICLO_LGD
	, T1.OR_EAD
	, T1.OR_EAD_NOMINAL
	, T1.OR_EAD_TEMP_NOMINAL
	, T1.OR_QUITA_PREV_SCIC
	, T1.PV_QUITA_PREV_SCIC
	, T1.ID_CASO_CORR
	, T1.ID_CASO_NOMINAL_CORR
	, T1.SEGM_CAT_NDOD_PRI
FROM &LIBWORK.&PREF_PROG._01 AS T1
;QUIT;


*HACER DO LOOP PARA CALCULAR LA LGD BE EN CADA PUNTO;
%DO I = 1 %TO &PERIODO.;

       %LET HITO = &I;
       %PUT &I; 


       *CREAR LA EAD BEST ESTIMATE Y DROPEAR TODAS LAS VARIABLES QUE SE CREARÃN EN ESTE PROCESO MES A MES.
                       MANTENER SOLO LAS FECHAS DE OBSERVACIÃ“N >= EL PERIODO;
       DATA &LIBWORK.&PREF_PROG._03_AUX_01;
           SET &LIBWORK.&PREF_PROG._03_AUX_00;
           
           IF PERIODO >= &HITO.; 

           OR_EAD_TEMP_BE = MAX(OR_DISPTO,0);

       RUN;


       *RECALCULAR LA DISTANCIA ENTRE LA FEC_OBS Y LA FECHA DE REFERENCIA.
                       CALCULAR TODOS LOS SALDOS PRESENT VALUE;
       DATA &LIBWORK.&PREF_PROG._03_AUX_02;
           SET &LIBWORK.&PREF_PROG._03_AUX_01;

			BY ID_CONTR_CICLO_LGD;

			RETAIN FC_HITO;

			IF FIRST.ID_CONTR_CICLO_LGD THEN DO;
				FC_HITO = FEC_OBS;
			END;
			ELSE DO;
				FC_HITO = FC_HITO;
			END;

			DIST_ANY_OBS1 = INTCK('MONTH',INPUT(PUT(FC_HITO,6.), YYMMN6.),INPUT(PUT(FEC_OBS,6.), YYMMN6.));
			DIST_ANY_OBS2 = DIST_ANY_OBS1 + 1;

			PV_PC_VAL 			= OR_PC2 				/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS2/12);
			PV_PC_CORR 			= OR_PC3_CORR 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS2/12);
			PV_PRECIO_VTA 		= PRECIO_VTA 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_AD_VAL 			= OR_AD2 				/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS2/12);
			PV_GR_L1_VAL 		= IM_GR_L1 				/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_ADJ 		= COST_L2_ADJ 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_MAN 		= COST_L2_MAN 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_VTA 		= COST_L2_VTA 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_GA_TOT_VAL 		= IM_GA_TOT 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_QUITA_VAL 		= IM_IMPORTE_QUITA 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_QUITA_CORR 		= OR_QUITA3_CORR 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);

                       
       RUN;

       *HACER SUM DE TODOS LOS CAMPOS DE FLUJOS NIVEL CICLO;
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_03 AS SELECT

           *
           
			, SUM(OR_PC2				)	AS OR_PC_SCIC
			, SUM(OR_PC3_CORR			)	AS OR_PC_CORR_SCIC
			, SUM(PRECIO_VTA			)	AS OR_PRECIO_VTA_SCIC
			, SUM(OR_AD2				)	AS OR_AD_SCIC
			, SUM(IM_GR_L1				)	AS OR_GR_L1_SCIC
			, SUM(COST_L2_ADJ			)	AS OR_COST_L2_ADJ_SCIC
			, SUM(COST_L2_MAN			)	AS OR_COST_L2_MAN_SCIC
			, SUM(COST_L2_VTA			)	AS OR_COST_L2_VTA_SCIC
			, SUM(IM_GA_TOT				)	AS OR_GA_TOT_SCIC
			, SUM(IM_IMPORTE_QUITA		)	AS OR_QUITA_SCIC
			, SUM(OR_QUITA3_CORR		)	AS OR_QUITA_CORR_SCIC
			, SUM(PV_PC_VAL				)	AS PV_PC_SCIC
			, SUM(PV_PC_CORR			)	AS PV_PC_CORR_SCIC
			, SUM(PV_PRECIO_VTA			)	AS PV_PRECIO_VTA_SCIC
			, SUM(PV_AD_VAL				)	AS PV_AD_SCIC
			, SUM(PV_GR_L1_VAL			)	AS PV_GR_L1_SCIC
			, SUM(PV_COST_L2_ADJ		)	AS PV_COST_L2_ADJ_SCIC
			, SUM(PV_COST_L2_MAN		)	AS PV_COST_L2_MAN_SCIC
			, SUM(PV_COST_L2_VTA		)	AS PV_COST_L2_VTA_SCIC
			, SUM(PV_GA_TOT_VAL			)	AS PV_GA_TOT_SCIC
			, SUM(PV_QUITA_VAL			)	AS PV_QUITA_SCIC
			, SUM(PV_QUITA_CORR			)	AS PV_QUITA_CORR_SCIC

       FROM &LIBWORK.&PREF_PROG._03_AUX_02

       	GROUP BY ID_CONTR_CICLO_LGD
		ORDER BY ID_CONTR_CICLO_LGD, PERIODO
;
       QUIT;

       *HACER SUM DE TODOS LOS CAMPOS DE FLUJOS NIVEL CICLO;
	   *calcular PC/AD antes de la fecha de referencia;
	   *campo REDU_EAD_BE especial para meses con OP_LGD (D_PC_DESC = 1);
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_03B AS SELECT

           ID_CONTR_CICLO_LGD
           
           , SUM(OR_PC2)          AS OR_PC_SCIC
           , SUM(OR_PC3_CORR)     AS OR_PC_CORR_SCIC
           , SUM(OR_AD2)          AS OR_AD_SCIC

/*		   , SUM(MIN(D_PC_DESC*OR_PC2, D_PC_DESC*PRECIO_VTA))	AS OR_REDU_EAD_BE*/

/*		   , SUM(D_PC_DESC*OR_PC2			)	AS OR_REDU_EAD_BE_AUX1*/
/*		   , SUM(D_PC_DESC*PRECIO_VTA		)	AS OR_REDU_EAD_BE_AUX2*/
/*		   , SUM(SW_OP_LGD_INFO*PRECIO_VTA	)	AS OR_REDU_EAD_BE_AUX3*/
/**/
/*		   , MIN( calculated OR_REDU_EAD_BE_AUX1*/
/*				, calculated OR_REDU_EAD_BE_AUX2*/
/*				, calculated OR_REDU_EAD_BE_AUX3*/
/*			) as OR_REDU_EAD_BE*/

/*		   , SUM(MIN(D_PC_DESC*OR_PC2, SW_OP_LGD_INFO*PRECIO_VTA))	AS OR_REDU_EAD_BE*/

/*		   , SUM(ABS(MAX(SIGN_REDU*D_PC_DESC*OR_PC2, SIGN_REDU*SW_OP_LGD_INFO*PRECIO_VTA)))	AS OR_REDU_EAD_BE*/

		   , SUM(PRECIO_VTA)	AS OR_REDU_EAD_BE

           , SUM(PV_PC_VAL)       AS PV_PC_SCIC
           , SUM(PV_PC_CORR)      AS PV_PC_CORR_SCIC
           , SUM(PV_AD_VAL)       AS PV_AD_SCIC

       FROM &LIBWORK.&PREF_PROG._01
       WHERE PERIODO < &HITO. AND FEC_OBS >= FC_FECINICIC_LGD

       GROUP BY ID_CONTR_CICLO_LGD;
       QUIT;

       *HACER SUM DE TODOS LOS CAMPOS DE FLUJOS NIVEL CICLO;
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_04B AS SELECT DISTINCT
			T1.ID_CONTR_CICLO_LGD
			, &HITO. AS PERIODO
			, T2.OR_EAD
			, T2.OR_EAD_NOMINAL
			, T2.ID_CASO_CORR
			, COALESCE(		OR_PC_SCIC, 0) AS 		OR_PC_SCIC                         
			, COALESCE(OR_PC_CORR_SCIC, 0) AS  OR_PC_CORR_SCIC           
			, COALESCE(		OR_AD_SCIC, 0) AS 		OR_AD_SCIC                        
			, COALESCE( OR_REDU_EAD_BE, 0) AS 	OR_REDU_EAD_BE
			, COALESCE(		PV_PC_SCIC, 0) AS 		PV_PC_SCIC                         
			, COALESCE(PV_PC_CORR_SCIC, 0) AS  PV_PC_CORR_SCIC            
			, COALESCE(		PV_AD_SCIC, 0) AS 		PV_AD_SCIC                         
			, CASE 
				WHEN T2.ID_CASO_CORR IN (5,6)																						  
				THEN T2.OR_EAD_TEMP_NOMINAL + T2.PV_QUITA_PREV_SCIC - COALESCE(OR_PC_SCIC /*OR_PC_CORR_SCIC*/, 0) - COALESCE(OR_AD_SCIC, 0)
				ELSE T2.OR_EAD_TEMP_NOMINAL + T2.PV_QUITA_PREV_SCIC - COALESCE(/*OR_PC_SCIC*/ OR_PC_CORR_SCIC, 0) - COALESCE(OR_AD_SCIC, 0) - OR_REDU_EAD_BE
			END AS OR_EAD_BE_TEMP					  
			, CASE 
				WHEN T2.ID_CASO_NOMINAL_CORR IN (5,6)
				THEN T2.OR_EAD_TEMP_NOMINAL + T2.OR_QUITA_PREV_SCIC - COALESCE(OR_PC_SCIC /*OR_PC_CORR_SCIC*/, 0) - COALESCE(OR_AD_SCIC, 0)	
				ELSE T2.OR_EAD_TEMP_NOMINAL + T2.OR_QUITA_PREV_SCIC - COALESCE(/*OR_PC_SCIC*/ OR_PC_CORR_SCIC, 0) - COALESCE(OR_AD_SCIC, 0) - OR_REDU_EAD_BE
			END AS OR_EAD_NOMINAL_BE_TEMP
       FROM &LIBWORK.&PREF_PROG._03_AUX_03B AS T1
       LEFT JOIN &LIBWORK.&PREF_PROG._03_AUX_00C AS T2
       ON T1.ID_CONTR_CICLO_LGD = T2.ID_CONTR_CICLO_LGD
       ;
       QUIT;

       *CREAR LA EAD DEFINITIVA, TENIENDO EN CUENTA LOS ADDITIONAL DRAWINGS FUTUROS PARA EMPRESAS;
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_04 AS SELECT
          T1.*

			, (CASE 
				WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN 0
                ELSE T1.OR_AD_SCIC 
			END) AS 	OR_AD_CORR_SCIC

			, (CASE 
				WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN 0
				ELSE T1.PV_AD_SCIC 
			END) AS 	PV_AD_CORR_SCIC

			, COALESCE((CASE 
				WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN T2.OR_EAD_BE_TEMP 			- T1.PV_AD_SCIC
		   		ELSE 					T2.OR_EAD_BE_TEMP 
			END), T3.OR_EAD			) AS   OR_EAD_BE

			, COALESCE((CASE 
				WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN T2.OR_EAD_NOMINAL_BE_TEMP 	- T1.OR_AD_SCIC
		   		ELSE 					T2.OR_EAD_NOMINAL_BE_TEMP 
			END), T3.OR_EAD_NOMINAL	) AS   OR_EAD_NOMINAL_BE

       FROM &LIBWORK.&PREF_PROG._03_AUX_03 T1

       LEFT JOIN &LIBWORK.&PREF_PROG._03_AUX_04B AS T2
       ON T1.ID_CONTR_CICLO_LGD = T2.ID_CONTR_CICLO_LGD

       LEFT JOIN &LIBWORK.&PREF_PROG._03_AUX_00C AS T3
       ON T1.ID_CONTR_CICLO_LGD = T3.ID_CONTR_CICLO_LGD

       WHERE T1.PERIODO = &HITO.; 
       QUIT;

       *APLICAR LAS FORMULAS DE LA LGD;
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_05 AS SELECT DISTINCT
			*
			, (CASE 
				WHEN OR_EAD_BE < 0.005 THEN 0
                WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 1 
                WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND PV_GA_TOT_SCIC LE PV_GR_L1_SCIC THEN 2
                WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 3 
                WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND PV_GA_TOT_SCIC LE PV_GR_L1_SCIC THEN 4
                WHEN 													PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 5
                ELSE 6 
			END) AS ID_CASO_BE
			, (CASE 
				WHEN OR_EAD_NOMINAL_BE < 0.005 THEN 0
                WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 1 
                WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND OR_GA_TOT_SCIC LE OR_GR_L1_SCIC THEN 2
                WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 3 
                WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND OR_GA_TOT_SCIC LE OR_GR_L1_SCIC THEN 4
                WHEN 													OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 5
                ELSE 6 
			END) AS ID_CASO_NOMINAL_BE

			, (case 
				WHEN CALCULATED ID_CASO_NOMINAL_BE = 0 THEN 0

				when CALCULATED ID_CASO_NOMINAL_BE = 1 then 
					(OR_EAD_NOMINAL_BE 						+ OR_COST_L2_ADJ_SCIC + OR_COST_L2_MAN_SCIC + OR_COST_L2_VTA_SCIC
					- (OR_PC_CORR_SCIC 						+ OR_AD_CORR_SCIC + OR_PRECIO_VTA_SCIC)) / OR_EAD_NOMINAL_BE 

				when CALCULATED ID_CASO_NOMINAL_BE = 2 then
					(OR_EAD_NOMINAL_BE 	+ OR_GR_L1_SCIC 	+ OR_COST_L2_ADJ_SCIC + OR_COST_L2_MAN_SCIC + OR_COST_L2_VTA_SCIC
					- (OR_PC_CORR_SCIC 	+ OR_GA_TOT_SCIC 	+ OR_AD_CORR_SCIC + OR_PRECIO_VTA_SCIC)) / OR_EAD_NOMINAL_BE 

				when CALCULATED ID_CASO_NOMINAL_BE = 3 then
					(OR_EAD_NOMINAL_BE 						+ OR_QUITA_CORR_SCIC 
					- (OR_PC_CORR_SCIC 						+ OR_AD_CORR_SCIC)) / OR_EAD_NOMINAL_BE 

				when CALCULATED ID_CASO_NOMINAL_BE = 4 then
					(OR_EAD_NOMINAL_BE 	+ OR_GR_L1_SCIC 	+ OR_QUITA_CORR_SCIC 
					- (OR_PC_CORR_SCIC 	+ OR_GA_TOT_SCIC	+ OR_AD_CORR_SCIC)) / OR_EAD_NOMINAL_BE 

				when CALCULATED ID_CASO_NOMINAL_BE = 5 then
					(OR_EAD_NOMINAL_BE 						+ OR_QUITA_SCIC 
					- (OR_PC_SCIC 							+ OR_AD_CORR_SCIC)) / OR_EAD_NOMINAL_BE

				else 
					(OR_EAD_NOMINAL_BE 	+ OR_GR_L1_SCIC 	+ OR_QUITA_SCIC 
					- (OR_PC_SCIC 		+ OR_GA_TOT_SCIC	+ OR_AD_CORR_SCIC )) / OR_EAD_NOMINAL_BE 
			end) as LGD_NOMINAL_BE

			, (case 
				WHEN CALCULATED ID_CASO_BE = 0 THEN 0

				when CALCULATED ID_CASO_BE = 1 then 
					(OR_EAD_BE 								+ PV_COST_L2_ADJ_SCIC + PV_COST_L2_MAN_SCIC + PV_COST_L2_VTA_SCIC
					- (PV_PC_CORR_SCIC 						+ PV_AD_CORR_SCIC + PV_PRECIO_VTA_SCIC)) / OR_EAD_BE 

				when CALCULATED ID_CASO_BE = 2 then
					(OR_EAD_BE 			+ PV_GR_L1_SCIC 	+ PV_COST_L2_ADJ_SCIC + PV_COST_L2_MAN_SCIC + PV_COST_L2_VTA_SCIC
					- (PV_PC_CORR_SCIC 	+ PV_GA_TOT_SCIC 	+ PV_AD_CORR_SCIC + PV_PRECIO_VTA_SCIC)) / OR_EAD_BE 

				when CALCULATED ID_CASO_BE = 3 then
					(OR_EAD_BE 								+ PV_QUITA_CORR_SCIC 
					- (PV_PC_CORR_SCIC 						+ PV_AD_CORR_SCIC)) / OR_EAD_BE 

				when CALCULATED ID_CASO_BE = 4 then
					(OR_EAD_BE 			+ PV_GR_L1_SCIC 	+ PV_QUITA_CORR_SCIC 
					- (PV_PC_CORR_SCIC 	+ PV_GA_TOT_SCIC	+ PV_AD_CORR_SCIC)) / OR_EAD_BE 

				when CALCULATED ID_CASO_BE = 5 then
					(OR_EAD_BE 								+ PV_QUITA_SCIC 
					- (PV_PC_SCIC 							+ PV_AD_CORR_SCIC)) / OR_EAD_BE

				else 
					(OR_EAD_BE 			+ PV_GR_L1_SCIC 	+ PV_QUITA_SCIC 
					- (PV_PC_SCIC 		+ PV_GA_TOT_SCIC	+ PV_AD_CORR_SCIC )) / OR_EAD_BE 
			end) as LGD_OBSERVADA_BE


       FROM &LIBWORK.&PREF_PROG._03_AUX_04

       ORDER BY ID_CONTR_CICLO_LGD;
       QUIT;

       *HACER UN SELECT DISTINCT DE LOS CAMPOS NIVEL CICLO - FECHA DE REFERENCIA;
       PROC SQL;
           CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_06 AS SELECT DISTINCT
                           T1.ID_CONTR_CICLO_LGD,
                           T1.PERIODO,
                           T1.FEC_OBS,
                           T1.FC_FECINICIC_LGD,
                           T1.FC_FECFINCIC_LGD,
                           

/*                           T1.SEGMBSINI_PRI, */
                           T1.SEGM_CAT_NDOD_PRI, /*interviene en cálculos*/
/*                           T1.MARCA_PROMO_CAP_PRI,*/
/*                           T1.MARCA_PROMO_AS_PRI,*/
/*                           T1.SEGRIE_CAT_NDOD_PRI, */
/*                           T1.SW_HIPO_BD_PRI,*/
/*                           T1.SW_HIPO_AS_PRI, */
                           T1.SW_MARCA_HIPO_PRI, 
/*                           T1.MOTIVO_ENTRADA_NDOD_PRI, */
/*                           T1.MOTIVO_MAS_GRAVE_NDOD_PRI,*/

                           T1.ID_CASO_CORR,
                           T1.LGD_OBSERVADA_CORR,
                           T1.TIPO_LGD, 
                           T1.OR_EAD_TEMP,
                           T1.OR_EAD_TEMP_BE,
                           T1.OR_PC_SCIC, 
                           T1.OR_PC_CORR_SCIC, 
                           T1.OR_PRECIO_VTA_SCIC, 
                           T1.OR_AD_SCIC, 
                           T1.OR_GR_L1_SCIC, 
                           T1.OR_COST_L2_ADJ_SCIC, 
                           T1.OR_COST_L2_MAN_SCIC, 
                           T1.OR_COST_L2_VTA_SCIC, 
                           T1.OR_GA_TOT_SCIC, 
                           T1.OR_QUITA_SCIC, 
                           T1.OR_QUITA_CORR_SCIC
						   , T1.OR_AD_CORR_SCIC /*&LIBWORK.&PREF_PROG._03_AUX_04*/
                           , T1.PV_PC_SCIC, 
                           T1.PV_PC_CORR_SCIC, 
                           T1.PV_PRECIO_VTA_SCIC, 
                           T1.PV_AD_SCIC, 
                           T1.PV_GR_L1_SCIC, 
                           T1.PV_COST_L2_ADJ_SCIC, 
                           T1.PV_COST_L2_MAN_SCIC, 
                           T1.PV_COST_L2_VTA_SCIC, 
                           T1.PV_GA_TOT_SCIC, 
                           T1.PV_QUITA_SCIC, 
                           T1.PV_QUITA_CORR_SCIC
						/*calculados en &LIBWORK.&PREF_PROG._03_AUX_04*/
                           , T1.PV_AD_CORR_SCIC
                           , T1.OR_EAD_BE
						   , T1.OR_EAD_NOMINAL_BE
						/*calculados en &LIBWORK.&PREF_PROG._03_AUX_05*/
                           , T1.ID_CASO_BE 
						   , T1.ID_CASO_NOMINAL_BE
                           , T1.LGD_OBSERVADA_BE
						   , T1.LGD_NOMINAL_BE

           FROM &LIBWORK.&PREF_PROG._03_AUX_05 T1;
       QUIT;


       *CREAR LA BASE DE LGD BE;       
       PROC APPEND FORCE
           BASE = &LIBWORK.BASE_LGD_BE
