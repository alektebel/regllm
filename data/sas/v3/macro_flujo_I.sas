/*SELECCIONEM ELS VALORS DE DISPTO_TIT I DISPTO_TIT_SEC DE LA TAULA DE RD A NIVELL FEC_OBS*/
PROC SQL;
CREATE TABLE &LIBWORK.I_P17_03_AUX AS SELECT DISTINCT
ID_CONTR_CICLO_LGD
,ID_TITULARITAT
,FEC_OBS
/*,OR_DISPTO_TIT_CORR*/
/*,OR_DISPTO_TIT_SEC*/
,K_NEW_OR_DISPTO_TIT 		AS OR_DISPTO_TIT_CORR
,K_NEW_OR_DISPTO_TIT_SEC	AS OR_DISPTO_TIT_SEC
FROM &TABLA_RD_A_NIVEL_FEC_OBS.
;QUIT;

/*CALCULEM LA CORRECCIÓ SOBRE OR_DISPTO_TIT A NIVELL TITULAR-FEC_OBS PER INCLOURE LES MODIFICACIONS DE LA EAD DEL CICLO A LA EAD_TIT*/
PROC SQL;
CREATE TABLE &LIBWORK.I_P17_01 AS SELECT DISTINCT

ID_TITULARITAT
,FEC_OBS
/*,OR_DISPTO_TIT*/
/*,OR_DISPTO_TIT_CORR*/
/*,OR_DISPTO_TIT_SEC*/
,SUM(max(coalesce(OR_EAD_BE			, 0) - OR_DISPTO, 0)) AS CORR_EAD_TIT
,SUM(max(coalesce(OR_EAD_NOMINAL_BE	, 0) - OR_DISPTO, 0)) AS CORR_EAD_NOMINAL_TIT

/*,SUM(CASE WHEN SW_MARCA_HIPO_PRI2 = 1 THEN */
,SUM(CASE WHEN SW_MARCA_HIPO_PRI = 1 THEN 
	 max(coalesce(OR_EAD_BE			, 0) - OR_DISPTO, 0)  ELSE 0 END) AS CORR_EAD_TIT_SEC

FROM &LIBWORK.I_P16_FIN
GROUP BY ID_TITULARITAT, FEC_OBS
ORDER BY ID_TITULARITAT, FEC_OBS DESC
;QUIT;

/*CONTAGIEM LA PRIMERA CORRECCIÓ INFORMADA A NIVELL TIT ALS MESOS DE RETROCESSIÓ*/
DATA &LIBWORK.I_P17_02;
SET &LIBWORK.I_P17_01;
RETAIN CORR_EAD_TIT_KEEP CORR_EAD_NOMINAL_TIT_KEEP CORR_EAD_TIT_SEC_KEEP;
BY ID_TITULARITAT;
IF FIRST.ID_TITULARITAT THEN DO;
	CORR_EAD_TIT_KEEP = CORR_EAD_TIT;
	CORR_EAD_NOMINAL_TIT_KEEP = CORR_EAD_NOMINAL_TIT;
	CORR_EAD_TIT_SEC_KEEP = CORR_EAD_TIT_SEC;
END;
ELSE IF CORR_EAD_TIT NE . THEN DO;
	CORR_EAD_TIT_KEEP = CORR_EAD_TIT;
	CORR_EAD_NOMINAL_TIT_KEEP = CORR_EAD_NOMINAL_TIT;
	CORR_EAD_TIT_SEC_KEEP = CORR_EAD_TIT_SEC;
END;
	CORR_EAD_TIT_FIN = CORR_EAD_TIT_KEEP;
	CORR_EAD_NOMINAL_TIT_FIN = CORR_EAD_NOMINAL_TIT_KEEP;
	CORR_EAD_TIT_SEC_FIN = CORR_EAD_TIT_SEC_KEEP;
RUN;



/*INCORPOREM ELS CAMPS DE CORR_EAD_TIT A LA TAULA ANTERIOR*/
PROC SQL;
CREATE TABLE &LIBWORK.I_P17_03 AS SELECT /*DISTINCT*/
T1.*, 
T2.CORR_EAD_TIT_FIN, 
T2.CORR_EAD_NOMINAL_TIT_FIN, 
T2.CORR_EAD_TIT_SEC_FIN	
FROM &LIBWORK.I_P17_03_AUX T1
LEFT JOIN &LIBWORK.I_P17_02 T2
	ON T1.ID_TITULARITAT = T2.ID_TITULARITAT
	AND T1.FEC_OBS = T2.FEC_OBS;
;QUIT;

/*CALCULEM LES EAD_TIT COM DISPTO_TIT + CORR_EAD_TIT, AFEGIM UN COALESCE PELS CASOS EN QUE CORR_EAD_TIT SIGUI NULL*/
DATA &LIBWORK.I_P17_04;
SET &LIBWORK.I_P17_03;
		OR_EAD_TIT_MES 	= OR_DISPTO_TIT_CORR 	+ coalesce(CORR_EAD_TIT_FIN			,0);
OR_EAD_NOMINAL_TIT_MES 	= OR_DISPTO_TIT_CORR 	+ coalesce(CORR_EAD_NOMINAL_TIT_FIN	,0);
		OR_EAD_TIT_SEC 	= OR_DISPTO_TIT_SEC 	+ coalesce(CORR_EAD_TIT_SEC_FIN		,0);

IF OR_DISPTO_TIT_CORR NOT IN (0,.) THEN RATIO_DISPTO_SEC_TIT_NEW = OR_DISPTO_TIT_SEC / OR_DISPTO_TIT_CORR;
	ELSE RATIO_DISPTO_SEC_TIT_NEW = 0;
IF OR_EAD_TIT_MES NOT IN (0,.) THEN RATIO_EAD_SEC_TIT_NEW = OR_EAD_TIT_SEC / OR_EAD_TIT_MES;
	ELSE RATIO_EAD_SEC_TIT_NEW = 0;
RUN;

