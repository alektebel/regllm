	SET &LIBWORK.&PREFIJO_PROGRAMA._01;

	PV_PC_VAL 		= OR_PC2 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS2/12);
	PV_PC_CORR 		= OR_PC3_CORR 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS2/12);
	PV_AD_VAL 		= OR_AD2 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS2/12);

 	PV_PRECIO_VTA 	= PRECIO_VTA 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);

	PV_GR_L1_VAL 	= IM_GR_L1 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
	PV_COST_L2_ADJ 	= COST_L2_ADJ 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
	PV_COST_L2_MAN 	= COST_L2_MAN 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
	PV_COST_L2_VTA 	= COST_L2_VTA 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);

	PV_GA_TOT_VAL 	= IM_GA_TOT 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);

	PV_QUITA_PREV	= IM_QUITA_PREVIA 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
	PV_QUITA_VAL 	= IM_IMPORTE_QUITA 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
	PV_QUITA_CORR 	= OR_QUITA3_CORR 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);

	PV_CI_VAL 		= OR_CI 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
	

