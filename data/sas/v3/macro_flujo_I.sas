	IM_IMPORTE_QUITA 	= coalesce(IM_IMPORTE_QUITA	,0);
	OR_QUITA3_CORR 		= coalesce(OR_QUITA3_CORR 	,0);

	IF FEC_OBS >= FC_FECINICIC_LGD THEN DO;
		PERIODO = intck('month', input(put(FC_FECINICIC_LGD,6.), yymmn6.), input(put(FEC_OBS,6.), yymmn6.)) + 1;
		DIST_ANY_OBS1 = PERIODO - 1;
		DIST_ANY_OBS2 = PERIODO;
	END;
	ELSE DO;
		PERIODO = intck('month', input(put(FC_FECINICIC_LGD,6.), yymmn6.), input(put(FEC_OBS,6.), yymmn6.)) + 0;
		DIST_ANY_OBS1 = .;
		DIST_ANY_OBS2 = .;
	END;

	IF FEC_OBS >= FC_FECINICIC_LGD and IM_GR_L1 ne . and IM_GR_L1 then do;
		IM_GA_TOT = IM_GA_TOT + IM_GR_L1;
		IM_GR_L1 = 0;
	end;

