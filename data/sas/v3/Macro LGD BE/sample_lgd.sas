%macro macro_OR_REDU_EAD_BE(ESTX);
/*, SUM(MIN(D_PC_DESC*OR_PC2, D_PC_DESC*OR_PRECIO_VTA_&ESTX.))	AS OR_REDU_EAD_BE_&ESTX.*/

/*, SUM(D_PC_DESC*OR_PC2					)	AS OR_REDU_EAD_BE_&ESTX._AUX1*/
/*, SUM(D_PC_DESC*OR_PRECIO_VTA_&ESTX.		)	AS OR_REDU_EAD_BE_&ESTX._AUX2*/
/*, SUM(SW_OP_LGD_INFO*OR_PRECIO_VTA_&ESTX.	)	AS OR_REDU_EAD_BE_&ESTX._AUX3*/
/**/
/*, MIN( calculated OR_REDU_EAD_BE_&ESTX._AUX1*/
/*	, calculated OR_REDU_EAD_BE_&ESTX._AUX2*/
/*	, calculated OR_REDU_EAD_BE_&ESTX._AUX3*/
/*) as OR_REDU_EAD_BE_&ESTX.*/

/*, SUM(MIN(D_PC_DESC*OR_PC2, SW_OP_LGD_INFO*OR_PRECIO_VTA_&ESTX.))	AS OR_REDU_EAD_BE_&ESTX.*/

, SUM(SA_PRECIO_VTA_&ESTX.)	AS OR_REDU_EAD_BE_&ESTX.
%mend;

%macro macro_OR_EAD_BE_TEMP(ESTX);
, CASE 
	WHEN T2.ID_CASO_CORR IN (5,6)																						  
	THEN T2.OR_EAD_TEMP_NOMINAL + T2.PV_QUITA_PREV_SCIC - COALESCE(OR_PC_SCIC /*OR_PC_CORR_SCIC*/, 0) - COALESCE(OR_AD_SCIC, 0)
	ELSE T2.OR_EAD_TEMP_NOMINAL + T2.PV_QUITA_PREV_SCIC - COALESCE(/*OR_PC_SCIC*/ OR_PC_CORR_SCIC, 0) - COALESCE(OR_AD_SCIC, 0) 
	 - OR_REDU_EAD_BE_&ESTX.
END AS OR_EAD_BE_TEMP_&ESTX.					  
, CASE 
	WHEN T2.ID_CASO_NOMINAL_CORR IN (5,6)
	THEN T2.OR_EAD_TEMP_NOMINAL + T2.OR_QUITA_PREV_SCIC - COALESCE(OR_PC_SCIC /*OR_PC_CORR_SCIC*/, 0) - COALESCE(OR_AD_SCIC, 0)	
	ELSE T2.OR_EAD_TEMP_NOMINAL + T2.OR_QUITA_PREV_SCIC - COALESCE(/*OR_PC_SCIC*/ OR_PC_CORR_SCIC, 0) - COALESCE(OR_AD_SCIC, 0)
			 - OR_REDU_EAD_BE_&ESTX.
END AS OR_EAD_NOMINAL_BE_TEMP_&ESTX.
%mend;

%macro macro_OR_EAD_BE(ESTX);
, COALESCE((CASE 
	WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN T2.OR_EAD_BE_TEMP_&ESTX. 			- T1.PV_AD_SCIC
   	ELSE 					T2.OR_EAD_BE_TEMP_&ESTX. 
END), T3.OR_EAD			) AS   OR_EAD_BE_&ESTX.

, COALESCE((CASE 
	WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN T2.OR_EAD_NOMINAL_BE_TEMP_&ESTX. 	- T1.OR_AD_SCIC
   	ELSE 					T2.OR_EAD_NOMINAL_BE_TEMP_&ESTX.
END), T3.OR_EAD_NOMINAL	) AS   OR_EAD_NOMINAL_BE_&ESTX.
%mend;

%macro macro_ID_CASO(ESTX);
, (CASE 
	WHEN OR_EAD_BE_&ESTX. < 0.005 THEN 0
    WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 1 
    WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND PV_GA_TOT_SCIC LE PV_GR_L1_SCIC THEN 2
    WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 3 
    WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND PV_GA_TOT_SCIC LE PV_GR_L1_SCIC THEN 4
    WHEN 													PV_GA_TOT_SCIC >  PV_GR_L1_SCIC THEN 5
    ELSE 6 
END) AS ID_CASO_BE_&ESTX.
, (CASE 
	WHEN OR_EAD_NOMINAL_BE_&ESTX. < 0.005 THEN 0
    WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 1 
    WHEN TERMINACION IN ("01. ADJ", "02. DACION") 		AND OR_GA_TOT_SCIC LE OR_GR_L1_SCIC THEN 2
    WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 3 
    WHEN SW_MARCA_HIPO_PRI = 0 AND SW_OP_LGD_DEF = 1 	AND OR_GA_TOT_SCIC LE OR_GR_L1_SCIC THEN 4
    WHEN 													OR_GA_TOT_SCIC >  OR_GR_L1_SCIC THEN 5
    ELSE 6 
END) AS ID_CASO_NOMINAL_BE_&ESTX.
%mend;

