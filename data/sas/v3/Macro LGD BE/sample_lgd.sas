PROC SQL;
CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_00C AS SELECT DISTINCT
	T1.ID_CONTR_CICLO_LGD
	, T1.OR_EAD
	, T1.OR_EAD_NOMINAL
	, T1.OR_EAD_TEMP_NOMINAL
	, T1.OR_QUITA_PREV_SCIC
	, T1.PV_QUITA_PREV_SCIC
	, T1.ID_CASO_CORR
	, T1.ID_CASO_NOMINAL_CORR
	, T1.SEGM_CAT_NDOD_PRI
FROM &LIBWORK.&PREF_PROG._01 AS T1
;QUIT;


*HACER DO LOOP PARA CALCULAR LA LGD BE EN CADA PUNTO;
%DO I = 1 %TO &PERIODO.;

       %LET HITO = &I;
       %PUT &I; 


       *CREAR LA EAD BEST ESTIMATE Y DROPEAR TODAS LAS VARIABLES QUE SE CREARÃN EN ESTE PROCESO MES A MES.
                       MANTENER SOLO LAS FECHAS DE OBSERVACIÃ“N >= EL PERIODO;
       DATA &LIBWORK.&PREF_PROG._03_AUX_01;
           SET &LIBWORK.&PREF_PROG._03_AUX_00;
           
           IF PERIODO >= &HITO.; 

           OR_EAD_TEMP_BE = MAX(OR_DISPTO,0);

       RUN;


       *RECALCULAR LA DISTANCIA ENTRE LA FEC_OBS Y LA FECHA DE REFERENCIA.
                       CALCULAR TODOS LOS SALDOS PRESENT VALUE;
       DATA &LIBWORK.&PREF_PROG._03_AUX_02;
           SET &LIBWORK.&PREF_PROG._03_AUX_01;

			BY ID_CONTR_CICLO_LGD;

			RETAIN FC_HITO;

			IF FIRST.ID_CONTR_CICLO_LGD THEN DO;
				FC_HITO = FEC_OBS;
			END;
			ELSE DO;
				FC_HITO = FC_HITO;
			END;

			DIST_ANY_OBS1 = INTCK('MONTH',INPUT(PUT(FC_HITO,6.), YYMMN6.),INPUT(PUT(FEC_OBS,6.), YYMMN6.));
			DIST_ANY_OBS2 = DIST_ANY_OBS1 + 1;

			PV_PC_VAL 			= OR_PC2 				/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_PC_CORR 			= OR_PC3_CORR 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_PRECIO_VTA_CH 	= OR_PRECIO_VTA_CH 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_PRECIO_VTA_EST1 	= OR_PRECIO_VTA_EST1 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_PRECIO_VTA_EST2 	= OR_PRECIO_VTA_EST2 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_PRECIO_VTA_EST3 	= OR_PRECIO_VTA_EST3 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_PRECIO_VTA_EST4 	= OR_PRECIO_VTA_EST4 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_AD_VAL 			= OR_AD2 				/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_GR_L1_VAL 		= IM_GR_L1 				/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_ADJ_M 	= OR_COST_L2_ADJ_M 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
/*			PV_COST_L2_MAN_M 	= OR_COST_L2_MAN_M 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);*/
			PV_COST_L2_MAN_EST1 = OR_COST_L2_MAN_EST1	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_MAN_EST2 = OR_COST_L2_MAN_EST2	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_MAN_EST3 = OR_COST_L2_MAN_EST3	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_MAN_EST4 = OR_COST_L2_MAN_EST4	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_VTA_EST1 = OR_COST_L2_VTA_EST1 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_VTA_EST2 = OR_COST_L2_VTA_EST2 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_VTA_EST3 = OR_COST_L2_VTA_EST3 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_COST_L2_VTA_EST4 = OR_COST_L2_VTA_EST4 	/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_GA_TOT_VAL 		= IM_GA_TOT 			/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_QUITA_VAL 		= IM_IMPORTE_QUITA 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);
			PV_QUITA_CORR 		= OR_QUITA3_CORR 		/ (1+(TIPO_LGD/100))**(DIST_ANY_OBS1/12);

                       
       RUN;

       *HACER SUM DE TODOS LOS CAMPOS DE FLUJOS NIVEL CICLO;
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_03 AS SELECT

           *
           
			, SUM(OR_PC2				)	AS OR_PC_SCIC
			, SUM(OR_PC3_CORR			)	AS OR_PC_CORR_SCIC
