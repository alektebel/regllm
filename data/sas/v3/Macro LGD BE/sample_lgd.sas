			, SUM(IM_GR_L1				)	AS OR_GR_L1_SCIC

			, SUM(OR_COST_L2_ADJ_M		)	AS OR_COST_L2_ADJ_M_SCIC
/*			, SUM(OR_COST_L2_MAN_M		)	AS OR_COST_L2_MAN_M_SCIC*/
			, SUM(OR_COST_L2_MAN_EST1	)	AS OR_COST_L2_MAN_EST1_SCIC
			, SUM(OR_COST_L2_MAN_EST2	)	AS OR_COST_L2_MAN_EST2_SCIC
			, SUM(OR_COST_L2_MAN_EST3	)	AS OR_COST_L2_MAN_EST3_SCIC
			, SUM(OR_COST_L2_MAN_EST4	)	AS OR_COST_L2_MAN_EST4_SCIC
			, SUM(OR_COST_L2_VTA_EST1	)	AS OR_COST_L2_VTA_EST1_SCIC
			, SUM(OR_COST_L2_VTA_EST2	)	AS OR_COST_L2_VTA_EST2_SCIC
			, SUM(OR_COST_L2_VTA_EST3	)	AS OR_COST_L2_VTA_EST3_SCIC
			, SUM(OR_COST_L2_VTA_EST4	)	AS OR_COST_L2_VTA_EST4_SCIC
			, SUM(SA_COST_L2_MAN_EST1	)	AS SA_COST_L2_MAN_EST1_SCIC
			, SUM(SA_COST_L2_MAN_EST2	)	AS SA_COST_L2_MAN_EST2_SCIC
			, SUM(SA_COST_L2_MAN_EST3	)	AS SA_COST_L2_MAN_EST3_SCIC
			, SUM(SA_COST_L2_MAN_EST4	)	AS SA_COST_L2_MAN_EST4_SCIC
			, SUM(SA_COST_L2_VTA_EST1	)	AS SA_COST_L2_VTA_EST1_SCIC
			, SUM(SA_COST_L2_VTA_EST2	)	AS SA_COST_L2_VTA_EST2_SCIC
			, SUM(SA_COST_L2_VTA_EST3	)	AS SA_COST_L2_VTA_EST3_SCIC
			, SUM(SA_COST_L2_VTA_EST4	)	AS SA_COST_L2_VTA_EST4_SCIC

			, SUM(IM_GA_TOT				)	AS OR_GA_TOT_SCIC
			, SUM(IM_IMPORTE_QUITA		)	AS OR_QUITA_SCIC
			, SUM(OR_QUITA3_CORR		)	AS OR_QUITA_CORR_SCIC

			, SUM(PV_PC_VAL				)	AS PV_PC_SCIC
			, SUM(PV_PC_CORR			)	AS PV_PC_CORR_SCIC
			, SUM(PV_PRECIO_VTA_CH		)	AS PV_PRECIO_VTA_CH_SCIC
			, SUM(PV_PRECIO_VTA_EST1	)	AS PV_PRECIO_VTA_EST1_SCIC
			, SUM(PV_PRECIO_VTA_EST2	)	AS PV_PRECIO_VTA_EST2_SCIC
			, SUM(PV_PRECIO_VTA_EST3	)	AS PV_PRECIO_VTA_EST3_SCIC
			, SUM(PV_PRECIO_VTA_EST4	)	AS PV_PRECIO_VTA_EST4_SCIC

			, SUM(PV_AD_VAL				)	AS PV_AD_SCIC
			, SUM(PV_GR_L1_VAL			)	AS PV_GR_L1_SCIC

			, SUM(PV_COST_L2_ADJ_M		)	AS PV_COST_L2_ADJ_M_SCIC
/*			, SUM(PV_COST_L2_MAN_M		)	AS PV_COST_L2_MAN_M_SCIC*/
			, SUM(PV_COST_L2_MAN_EST1	)	AS PV_COST_L2_MAN_EST1_SCIC
			, SUM(PV_COST_L2_MAN_EST2	)	AS PV_COST_L2_MAN_EST2_SCIC
			, SUM(PV_COST_L2_MAN_EST3	)	AS PV_COST_L2_MAN_EST3_SCIC
			, SUM(PV_COST_L2_MAN_EST4	)	AS PV_COST_L2_MAN_EST4_SCIC
			, SUM(PV_COST_L2_VTA_EST1	)	AS PV_COST_L2_VTA_EST1_SCIC
			, SUM(PV_COST_L2_VTA_EST2	)	AS PV_COST_L2_VTA_EST2_SCIC
			, SUM(PV_COST_L2_VTA_EST3	)	AS PV_COST_L2_VTA_EST3_SCIC
			, SUM(PV_COST_L2_VTA_EST4	)	AS PV_COST_L2_VTA_EST4_SCIC

			, SUM(PV_GA_TOT_VAL			)	AS PV_GA_TOT_SCIC
			, SUM(PV_QUITA_VAL			)	AS PV_QUITA_SCIC
			, SUM(PV_QUITA_CORR			)	AS PV_QUITA_CORR_SCIC

       FROM &LIBWORK.&PREF_PROG._03_AUX_02

       	GROUP BY ID_CONTR_CICLO_LGD
		ORDER BY ID_CONTR_CICLO_LGD, PERIODO
;
       QUIT;

       *HACER SUM DE TODOS LOS CAMPOS DE FLUJOS NIVEL CICLO;
	   *calcular PC/AD antes de la fecha de referencia;
	   *campo REDU_EAD_BE especial para meses con OP_LGD (D_PC_DESC = 1);
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_03B AS SELECT

           ID_CONTR_CICLO_LGD
           
           , SUM(OR_PC2)          AS OR_PC_SCIC
           , SUM(OR_PC3_CORR)     AS OR_PC_CORR_SCIC
           , SUM(OR_AD2)          AS OR_AD_SCIC

		   %macro_OR_REDU_EAD_BE(EST1)
		   %macro_OR_REDU_EAD_BE(EST2)
		   %macro_OR_REDU_EAD_BE(EST3)
		   %macro_OR_REDU_EAD_BE(EST4)

           , SUM(PV_PC_VAL)       AS PV_PC_SCIC
           , SUM(PV_PC_CORR)      AS PV_PC_CORR_SCIC
           , SUM(PV_AD_VAL)       AS PV_AD_SCIC

       FROM &LIBWORK.&PREF_PROG._01
       WHERE PERIODO < &HITO. AND FEC_OBS >= FC_FECINICIC_LGD

       GROUP BY ID_CONTR_CICLO_LGD;
       QUIT;

       *HACER SUM DE TODOS LOS CAMPOS DE FLUJOS NIVEL CICLO;
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_04B AS SELECT DISTINCT
			T1.ID_CONTR_CICLO_LGD
			, &HITO. AS PERIODO
			, T2.OR_EAD
			, T2.OR_EAD_NOMINAL
			, T2.ID_CASO_CORR
			, COALESCE(		OR_PC_SCIC, 0) AS 		OR_PC_SCIC                         
			, COALESCE(OR_PC_CORR_SCIC, 0) AS  OR_PC_CORR_SCIC           
			, COALESCE(		OR_AD_SCIC, 0) AS 		OR_AD_SCIC                        
			, COALESCE( OR_REDU_EAD_BE_EST1, 0) AS 	OR_REDU_EAD_BE_EST1
			, COALESCE( OR_REDU_EAD_BE_EST2, 0) AS 	OR_REDU_EAD_BE_EST2
			, COALESCE( OR_REDU_EAD_BE_EST3, 0) AS 	OR_REDU_EAD_BE_EST3
			, COALESCE( OR_REDU_EAD_BE_EST4, 0) AS 	OR_REDU_EAD_BE_EST4
			, COALESCE(		PV_PC_SCIC, 0) AS 		PV_PC_SCIC                         
			, COALESCE(PV_PC_CORR_SCIC, 0) AS  PV_PC_CORR_SCIC            
			, COALESCE(		PV_AD_SCIC, 0) AS 		PV_AD_SCIC                         

			%macro_OR_EAD_BE_TEMP(EST1)
			%macro_OR_EAD_BE_TEMP(EST2)
			%macro_OR_EAD_BE_TEMP(EST3)
			%macro_OR_EAD_BE_TEMP(EST4)
       FROM &LIBWORK.&PREF_PROG._03_AUX_03B AS T1
       LEFT JOIN &LIBWORK.&PREF_PROG._03_AUX_00C AS T2
       ON T1.ID_CONTR_CICLO_LGD = T2.ID_CONTR_CICLO_LGD
       ;
       QUIT;

       *CREAR LA EAD DEFINITIVA, TENIENDO EN CUENTA LOS ADDITIONAL DRAWINGS FUTUROS PARA EMPRESAS;
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_04 AS SELECT
          T1.*

			, (CASE 
				WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN 0
                ELSE T1.OR_AD_SCIC 
			END) AS 	OR_AD_CORR_SCIC

			, (CASE 
				WHEN T1.SEGM_CAT_NDOD_PRI IN ('EMPR') THEN 0
				ELSE T1.PV_AD_SCIC 
			END) AS 	PV_AD_CORR_SCIC

			%macro_OR_EAD_BE(EST1)
			%macro_OR_EAD_BE(EST2)
			%macro_OR_EAD_BE(EST3)
			%macro_OR_EAD_BE(EST4)

       FROM &LIBWORK.&PREF_PROG._03_AUX_03 T1

       LEFT JOIN &LIBWORK.&PREF_PROG._03_AUX_04B AS T2
       ON T1.ID_CONTR_CICLO_LGD = T2.ID_CONTR_CICLO_LGD

       LEFT JOIN &LIBWORK.&PREF_PROG._03_AUX_00C AS T3
       ON T1.ID_CONTR_CICLO_LGD = T3.ID_CONTR_CICLO_LGD

       WHERE T1.PERIODO = &HITO.; 
       QUIT;

       *APLICAR LAS FORMULAS DE LA LGD;
       PROC SQL;
       CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_05 AS SELECT DISTINCT
			*
			
			%macro_ID_CASO(EST1)
			%macro_ID_CASO(EST2)
			%macro_ID_CASO(EST3)
			%macro_ID_CASO(EST4)

			, %formula_lgd(ID_CASO=CALCULATED ID_CASO_NOMINAL_BE_EST1	, EAD=OR_EAD_NOMINAL_BE_EST1, PREF=OR_, EST=EST1, NOMBRE=LGD_NOM_BE_EST1)
			, %formula_lgd(ID_CASO=CALCULATED ID_CASO_NOMINAL_BE_EST2	, EAD=OR_EAD_NOMINAL_BE_EST2, PREF=OR_, EST=EST2, NOMBRE=LGD_NOM_BE_EST2)
			, %formula_lgd(ID_CASO=CALCULATED ID_CASO_NOMINAL_BE_EST3	, EAD=OR_EAD_NOMINAL_BE_EST3, PREF=OR_, EST=EST3, NOMBRE=LGD_NOM_BE_EST3)
			, %formula_lgd(ID_CASO=CALCULATED ID_CASO_NOMINAL_BE_EST4	, EAD=OR_EAD_NOMINAL_BE_EST4, PREF=OR_, EST=EST4, NOMBRE=LGD_NOM_BE_EST4)
			, %formula_lgd(ID_CASO=CALCULATED ID_CASO_BE_EST1			, EAD=OR_EAD_BE_EST1		, PREF=PV_, EST=EST1, NOMBRE=LGD_OBS_BE_EST1)
			, %formula_lgd(ID_CASO=CALCULATED ID_CASO_BE_EST2			, EAD=OR_EAD_BE_EST2		, PREF=PV_, EST=EST2, NOMBRE=LGD_OBS_BE_EST2)
			, %formula_lgd(ID_CASO=CALCULATED ID_CASO_BE_EST3			, EAD=OR_EAD_BE_EST3		, PREF=PV_, EST=EST3, NOMBRE=LGD_OBS_BE_EST3)
			, %formula_lgd(ID_CASO=CALCULATED ID_CASO_BE_EST4			, EAD=OR_EAD_BE_EST4		, PREF=PV_, EST=EST4, NOMBRE=LGD_OBS_BE_EST4)


       FROM &LIBWORK.&PREF_PROG._03_AUX_04

       ORDER BY ID_CONTR_CICLO_LGD;
       QUIT;

       *HACER UN SELECT DISTINCT DE LOS CAMPOS NIVEL CICLO - FECHA DE REFERENCIA;
       PROC SQL;
           CREATE TABLE &LIBWORK.&PREF_PROG._03_AUX_06 AS SELECT DISTINCT
                           T1.ID_CONTR_CICLO_LGD,
                           T1.PERIODO,
                           T1.FEC_OBS,
                           T1.FC_FECINICIC_LGD,
                           T1.FC_FECFINCIC_LGD,
                           

/*                           T1.SEGMBSINI_PRI, */
                           T1.SEGM_CAT_NDOD_PRI, /*interviene en cálculos*/
/*                           T1.MARCA_PROMO_CAP_PRI,*/
/*                           T1.MARCA_PROMO_AS_PRI,*/
/*                           T1.SEGRIE_CAT_NDOD_PRI, */
/*                           T1.SW_HIPO_BD_PRI,*/
/*                           T1.SW_HIPO_AS_PRI, */
                           T1.SW_MARCA_HIPO_PRI, 
/*                           T1.MOTIVO_ENTRADA_NDOD_PRI, */
/*                           T1.MOTIVO_MAS_GRAVE_NDOD_PRI,*/
						   T1.SW_OP_LGD_DEF,

                           T1.ID_CASO_CORR,
/*                           T1.LGD_OBSERVADA_CORR,*/
						   T1.LGD_OBS_EST1,
						   T1.LGD_OBS_EST2,
						   T1.LGD_OBS_EST3,
						   T1.LGD_OBS_EST4,
						   T1.LGD_NOM_EST1,
						   T1.LGD_NOM_EST2,
						   T1.LGD_NOM_EST3,
						   T1.LGD_NOM_EST4,
                           T1.TIPO_LGD, 
                           T1.OR_EAD_TEMP,
                           T1.OR_EAD_TEMP_BE,
                           T1.OR_PC_SCIC, 
                           T1.OR_PC_CORR_SCIC, 
                           T1.OR_PRECIO_VTA_CH_SCIC, 
						   T1.OR_PRECIO_VTA_EST1_SCIC, 
						   T1.OR_PRECIO_VTA_EST2_SCIC, 
						   T1.OR_PRECIO_VTA_EST3_SCIC, 
						   T1.OR_PRECIO_VTA_EST4_SCIC, 
						   T1.SA_PRECIO_VTA_EST1_SCIC, 
						   T1.SA_PRECIO_VTA_EST2_SCIC, 
						   T1.SA_PRECIO_VTA_EST3_SCIC, 
						   T1.SA_PRECIO_VTA_EST4_SCIC, 
                           T1.OR_AD_SCIC, 
                           T1.OR_GR_L1_SCIC, 
                           T1.OR_COST_L2_ADJ_M_SCIC, 
/*                           T1.OR_COST_L2_MAN_M_SCIC, */
						   T1.OR_COST_L2_MAN_EST1_SCIC, 
						   T1.OR_COST_L2_MAN_EST2_SCIC, 
						   T1.OR_COST_L2_MAN_EST3_SCIC, 
						   T1.OR_COST_L2_MAN_EST4_SCIC, 
                           T1.OR_COST_L2_VTA_EST1_SCIC, 
						   T1.OR_COST_L2_VTA_EST2_SCIC, 
						   T1.OR_COST_L2_VTA_EST3_SCIC, 
						   T1.OR_COST_L2_VTA_EST4_SCIC, 
						   T1.SA_COST_L2_MAN_EST1_SCIC, 
						   T1.SA_COST_L2_MAN_EST2_SCIC, 
						   T1.SA_COST_L2_MAN_EST3_SCIC, 
						   T1.SA_COST_L2_MAN_EST4_SCIC, 
                           T1.SA_COST_L2_VTA_EST1_SCIC, 
						   T1.SA_COST_L2_VTA_EST2_SCIC, 
						   T1.SA_COST_L2_VTA_EST3_SCIC, 
						   T1.SA_COST_L2_VTA_EST4_SCIC, 
                           T1.OR_GA_TOT_SCIC, 
                           T1.OR_QUITA_SCIC, 
                           T1.OR_QUITA_CORR_SCIC
						   , T1.OR_AD_CORR_SCIC /*&LIBWORK.&PREF_PROG._03_AUX_04*/
                           , T1.PV_PC_SCIC, 
                           T1.PV_PC_CORR_SCIC, 
                           T1.PV_PRECIO_VTA_CH_SCIC, 
						   T1.PV_PRECIO_VTA_EST1_SCIC, 
						   T1.PV_PRECIO_VTA_EST2_SCIC, 
						   T1.PV_PRECIO_VTA_EST3_SCIC, 
						   T1.PV_PRECIO_VTA_EST4_SCIC, 
                           T1.PV_AD_SCIC, 
                           T1.PV_GR_L1_SCIC, 
                           T1.PV_COST_L2_ADJ_M_SCIC, 
/*                           T1.PV_COST_L2_MAN_M_SCIC, */
						   T1.PV_COST_L2_MAN_EST1_SCIC, 
						   T1.PV_COST_L2_MAN_EST2_SCIC, 
						   T1.PV_COST_L2_MAN_EST3_SCIC, 
						   T1.PV_COST_L2_MAN_EST4_SCIC, 
                           T1.PV_COST_L2_VTA_EST1_SCIC, 
						   T1.PV_COST_L2_VTA_EST2_SCIC, 
						   T1.PV_COST_L2_VTA_EST3_SCIC, 
						   T1.PV_COST_L2_VTA_EST4_SCIC, 
                           T1.PV_GA_TOT_SCIC, 
                           T1.PV_QUITA_SCIC, 
                           T1.PV_QUITA_CORR_SCIC
						/*calculados en &LIBWORK.&PREF_PROG._03_AUX_04*/
                           , T1.PV_AD_CORR_SCIC
                           , T1.OR_EAD_BE_EST1,  T1.OR_EAD_NOMINAL_BE_EST1
						   , T1.OR_EAD_BE_EST2,  T1.OR_EAD_NOMINAL_BE_EST2
						   , T1.OR_EAD_BE_EST3,  T1.OR_EAD_NOMINAL_BE_EST3
						   , T1.OR_EAD_BE_EST4,  T1.OR_EAD_NOMINAL_BE_EST4
						/*calculados en &LIBWORK.&PREF_PROG._03_AUX_05*/
                           , T1.ID_CASO_BE_EST1, T1.ID_CASO_NOMINAL_BE_EST1
						   , T1.ID_CASO_BE_EST2, T1.ID_CASO_NOMINAL_BE_EST2
						   , T1.ID_CASO_BE_EST3, T1.ID_CASO_NOMINAL_BE_EST3
						   , T1.ID_CASO_BE_EST4, T1.ID_CASO_NOMINAL_BE_EST4
                           , T1.LGD_OBS_BE_EST1
						   , T1.LGD_NOM_BE_EST1
						   , T1.LGD_OBS_BE_EST2
						   , T1.LGD_NOM_BE_EST2
						   , T1.LGD_OBS_BE_EST3
						   , T1.LGD_NOM_BE_EST3
						   , T1.LGD_OBS_BE_EST4
						   , T1.LGD_NOM_BE_EST4

           FROM &LIBWORK.&PREF_PROG._03_AUX_05 T1;
       QUIT;


       *CREAR LA BASE DE LGD BE;       
       PROC APPEND FORCE
           BASE = &LIBWORK.BASE_LGD_BE
           DATA = &LIBWORK.&PREF_PROG._03_AUX_06;
       RUN;

	   PROC APPEND FORCE
           BASE = &LIBWORK.BASE_EAD_BE
           DATA = &LIBWORK.&PREF_PROG._03_AUX_04B;
       RUN;

	   

       *DROP LAS TABLAS INTERMEDIAS;
/*       PROC SQL; */
/*           DROP TABLE 	&LIBWORK.&PREF_PROG._03_AUX_01,*/
/*                        &LIBWORK.&PREF_PROG._03_AUX_02,*/
/*                        &LIBWORK.&PREF_PROG._03_AUX_03,*/
/*                        &LIBWORK.&PREF_PROG._03_AUX_04,*/
/*                        &LIBWORK.&PREF_PROG._03_AUX_05,*/
/*                        &LIBWORK.&PREF_PROG._03_AUX_06;*/
/*       QUIT;*/


       *HACER CHECK SI LA LGD BE = LGD DEL CICLO PARA LA PRIMERA OBSERVACIÓN;
       %IF &HITO. = 1 %THEN %DO;
			%CH_LGD_BE(LGD_CIC=LGD_OBS_EST1, LGD_BE=LGD_OBS_BE_EST1, SUFIJO_OUTPUT=&SUF_TAB_BE._OBS_EST1);
			%CH_LGD_BE(LGD_CIC=LGD_OBS_EST2, LGD_BE=LGD_OBS_BE_EST2, SUFIJO_OUTPUT=&SUF_TAB_BE._OBS_EST2);
			%CH_LGD_BE(LGD_CIC=LGD_OBS_EST3, LGD_BE=LGD_OBS_BE_EST3, SUFIJO_OUTPUT=&SUF_TAB_BE._OBS_EST3);
			%CH_LGD_BE(LGD_CIC=LGD_OBS_EST4, LGD_BE=LGD_OBS_BE_EST4, SUFIJO_OUTPUT=&SUF_TAB_BE._OBS_EST4);
			%CH_LGD_BE(LGD_CIC=LGD_NOM_EST1, LGD_BE=LGD_NOM_BE_EST1, SUFIJO_OUTPUT=&SUF_TAB_BE._NOM_EST1);
			%CH_LGD_BE(LGD_CIC=LGD_NOM_EST2, LGD_BE=LGD_NOM_BE_EST2, SUFIJO_OUTPUT=&SUF_TAB_BE._NOM_EST2);
			%CH_LGD_BE(LGD_CIC=LGD_NOM_EST3, LGD_BE=LGD_NOM_BE_EST3, SUFIJO_OUTPUT=&SUF_TAB_BE._NOM_EST3);
			%CH_LGD_BE(LGD_CIC=LGD_NOM_EST4, LGD_BE=LGD_NOM_BE_EST4, SUFIJO_OUTPUT=&SUF_TAB_BE._NOM_EST4);
       %END;
%END;

%MEND;

%macro LGD_CICLO_BE_EST(PREFIJO_PROGRAMA, T_IN_LPF_LGD_BE, SUFIJO_TABLAS_BE);
*capturar sólo los meses in-ciclo
PERIODO (como columna) se asume que ya está calculado;
DATA &LIBWORK.&PREFIJO_PROGRAMA._01;
SET &T_IN_LPF_LGD_BE.;
WHERE FEC_OBS BETWEEN FC_FECINICIC_LGD AND FC_FECFINCIC_LGD
;
IF (/*OP_LGD ne '' or*/ OP_LGD_DEF ne '') then DO;
	SW_OP_LGD_INFO = 1;
end;
else do;
	SW_OP_LGD_INFO = 0; 
end;
RUN;

%PUT &PERIODO;
/*options compress=no;*/



%LGD_BE_EST(PREF_PROG = &PREFIJO_PROGRAMA., SUF_TAB_BE = &SUFIJO_TABLAS_BE.);



*CRUZAR LAS LGD BES CON LA TABLA DE LA LGD PRE FILT;
PROC SQL;
CREATE TABLE &LIBWORK.&PREFIJO_PROGRAMA._FIN AS SELECT DISTINCT
		T1.*
		, T2.OR_EAD_BE_EST1,  T2.OR_EAD_NOMINAL_BE_EST1
		, T2.OR_EAD_BE_EST2,  T2.OR_EAD_NOMINAL_BE_EST2
		, T2.OR_EAD_BE_EST3,  T2.OR_EAD_NOMINAL_BE_EST3
		, T2.OR_EAD_BE_EST4,  T2.OR_EAD_NOMINAL_BE_EST4
		, T2.ID_CASO_BE_EST1, T2.ID_CASO_NOMINAL_BE_EST1
		, T2.ID_CASO_BE_EST2, T2.ID_CASO_NOMINAL_BE_EST2
		, T2.ID_CASO_BE_EST3, T2.ID_CASO_NOMINAL_BE_EST3
		, T2.ID_CASO_BE_EST4, T2.ID_CASO_NOMINAL_BE_EST4
		, T2.LGD_NOM_BE_EST1
		, T2.LGD_NOM_BE_EST2
		, T2.LGD_NOM_BE_EST3
		, T2.LGD_NOM_BE_EST4
		, T2.LGD_OBS_BE_EST1
		, T2.LGD_OBS_BE_EST2
		, T2.LGD_OBS_BE_EST3
		, T2.LGD_OBS_BE_EST4

FROM &LIBWORK.&PREFIJO_PROGRAMA._03_AUX_00 AS T1

LEFT JOIN &LIBWORK.BASE_LGD_BE AS T2
ON T1.ID_CONTR_CICLO_LGD = T2.ID_CONTR_CICLO_LGD
       AND T1.PERIODO = T2.PERIODO

ORDER BY T1.ID_CONTR_CICLO_LGD, T1.PERIODO;
QUIT;

*GUARDAR LA TABLA CON TODOS LOS FLUJOS PARA PODER CALCULAR LAS LGD BES;
PROC SQL;
   CREATE TABLE LGD_BE_&VERSION._&SUFIJO_TABLAS_BE. AS SELECT
		T1.*

   FROM &LIBWORK.BASE_LGD_BE T1

   ORDER BY T1.ID_CONTR_CICLO_LGD, T1.PERIODO;
QUIT;

PROC SQL;
   CREATE TABLE EAD_BE_&VERSION._&SUFIJO_TABLAS_BE. AS SELECT
		T1.*

   FROM &LIBWORK.BASE_EAD_BE T1
   INNER JOIN &LIBWORK.BASE_LGD_BE T2
   	   ON T1.ID_CONTR_CICLO_LGD = T2.ID_CONTR_CICLO_LGD
       AND T1.PERIODO = T2.PERIODO

   ORDER BY T1.ID_CONTR_CICLO_LGD, T1.PERIODO;
QUIT;

*DROP LAS TABLAS INTERMEDIAS;
