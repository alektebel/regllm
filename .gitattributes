# Default to LF for text files; Windows checkouts must not turn shell
# scripts into CRLF, otherwise `sh` inside Linux containers fails with
# "no such file or directory".
* text=auto eol=lf

# Shell / entrypoint scripts: always LF.
*.sh           text eol=lf
docker/**      text eol=lf

# Windows-only scripts: always CRLF.
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf

# Binary assets — leave untouched.
*.png          binary
*.jpg          binary
*.jpeg         binary
*.gif          binary
*.svg          text
*.ico          binary
*.pdf          binary
*.zip          binary
