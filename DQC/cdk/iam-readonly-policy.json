{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SeeDqcPoc",
      "Effect": "Allow",
      "Action": [
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:GetTemplate",
        "ecs:List*",
        "ecs:Describe*",
        "ecr:Describe*",
