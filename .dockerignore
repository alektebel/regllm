# Build context = repository root for the API image only.
# Keep this lean; the frontend has its own Dockerfile + .dockerignore.

# VCS
.git
.github
.gitattributes
.gitignore

# Editor / IDE
.vscode
.idea
.cursor
.claude

# Python caches
__pycache__
**/__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
.venv
venv

# Frontend (built separately)
frontend
node_modules

# Tests, demos, docs (not needed at runtime)
tests
demo
docs
README.md
*.md

# Local OS junk
.DS_Store
Thumbs.db

# Local env / containers
.env
.env.*
!.env.example
docker-compose.override.yml

# Windows launchers (not needed inside the container)
*.bat
*.cmd
*.ps1
