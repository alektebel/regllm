# Groq API (required for --backend groq)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=regllm
POSTGRES_USER=regllm
POSTGRES_PASSWORD=changeme

# JWT auth (FastAPI / Next.js)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=168

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gradio app
API_HOST=0.0.0.0
API_PORT=8000

# Model (path to finetuned model — leave empty to auto-detect latest)
MODEL_PATH=
BASE_MODEL=Qwen/Qwen2.5-7B-Instruct

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=./mlruns

# Adapter auto-download
ADAPTER_HF_REPO=
MODEL_S3_URI=
MLFLOW_MODEL_NAME=regllm-lora-adapter
MLFLOW_MODEL_STAGE=Production
