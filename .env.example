# RegLLM environment overrides.  Copy this file to `.env` and edit as needed:
#     cp .env.example .env
# `docker compose up` will pick it up automatically.

# ── LLM ─────────────────────────────────────────────────────────────────────
# Pick the Ollama model that fits your machine. The dockerised Ollama runs on
# CPU by default; expect ~30-60 s per agent turn on the 14B model.
#
#   qwen2.5:14b-instruct-q4_K_M   ~9 GB on disk, needs ~16 GB RAM. (default)
#   qwen2.5:7b-instruct-q4_K_M    ~4.7 GB,        needs ~8 GB RAM.
#   qwen2.5:3b-instruct-q4_K_M    ~2 GB,          needs ~4 GB RAM.
#   gemma2:9b-instruct-q4_K_M     alternative chat-tool-capable model.
#   none                           skip model download (LLM falls back to stub mode)
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# ── Host ports ──────────────────────────────────────────────────────────────
# Change these if the defaults clash with other services on your machine.
API_PORT=8000
WEB_PORT=3010
OLLAMA_PORT=11434
