# RegLLM environment overrides.  Copy this file to `.env` and edit as needed:
#     cp .env.example .env
# `docker compose up` will pick it up automatically.

# ── LLM backend ────────────────────────────────────────────────────────────
# REGLLM_LLM controls which backend the API uses:
#   auto     — probe LiteRT → Ollama → GGUF → Bedrock → stub (default)
#   ollama   — force Ollama
#   gguf     — force the standalone GGUF backend (see below)
#   bedrock  — force Amazon Bedrock (requires IAM credentials)
#   stub     — deterministic placeholder (for testing)
REGLLM_LLM=auto

# ── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen3:4b

# ── Standalone GGUF (llama-cpp-python, no Ollama server needed) ───────────
# Loads the weight file directly in-process. Distinct from pointing
# OLLAMA_MODEL at a .gguf path (that registers it INTO Ollama instead).
# Requires: pip install llama-cpp-python
# GGUF_MODEL_PATH=/models/qwen3-8b-instruct.Q4_K_M.gguf
# GGUF_N_CTX=8192
# GGUF_N_GPU_LAYERS=0
# GGUF_N_THREADS=
# GGUF_CHAT_FORMAT=

# ── Amazon Bedrock (when REGLLM_LLM=bedrock) ──────────────────────────────
# BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
# BEDROCK_REGION=eu-west-1

# ── Embeddings (regulation RAG + knowledge-graph RAG) ─────────────────────
# REGLLM_EMBED_BACKEND controls the embedding backend independently of
# REGLLM_LLM (e.g. chat via Bedrock, embeddings via a local Ollama model):
#   auto | ollama | gguf | bedrock | stub
# REGLLM_EMBED_BACKEND=auto
# REGLLM_EMBED_MODEL=nomic-embed-text
# GGUF_EMBED_MODEL_PATH=/models/nomic-embed-text-v1.5.Q8_0.gguf
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ── Host ports ─────────────────────────────────────────────────────────────
API_PORT=8000
DQC_PORT=4200
OLLAMA_PORT=11434
