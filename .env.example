# RegLLM environment overrides.  Copy this file to `.env` and edit as needed:
#     cp .env.example .env
# `docker compose up` will pick it up automatically.

# ── LLM backend ────────────────────────────────────────────────────────────
# REGLLM_LLM controls which backend the API uses:
#   auto     — probe LiteRT → Ollama → Bedrock → stub (default)
#   ollama   — force Ollama
#   bedrock  — force Amazon Bedrock (requires IAM credentials)
#   stub     — deterministic placeholder (for testing)
REGLLM_LLM=auto

# ── Ollama ─────────────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen3:4b

# ── Amazon Bedrock (when REGLLM_LLM=bedrock) ──────────────────────────────
# BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
# BEDROCK_REGION=eu-west-1

# ── Checks store ───────────────────────────────────────────────────────────
# Where generated/validated DQCs are persisted:
#   sqlite   — local file at data/dq/checks.db (default; offline)
#   dynamodb — requires CHECKS_TABLE + AWS credentials (set by CDK in AWS)
# CHECKS_BACKEND=sqlite
# CHECKS_TABLE=regllm-dqc-checks

# ── Host ports ─────────────────────────────────────────────────────────────
API_PORT=8000
DQC_PORT=4200
OLLAMA_PORT=11434
